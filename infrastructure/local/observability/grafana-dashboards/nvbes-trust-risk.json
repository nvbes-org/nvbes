      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"nvbes-trust-risk-service\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_spanmetrics_calls_total{service_name=\"nvbes-trust-risk-service\"}[5m])), 0.001)",
