logging {
  level  = "info"
  format = "logfmt"
}

local.file "grafana_cloud_prometheus_token" {
  filename  = "/run/secrets/grafana_cloud_prometheus_token"
  is_secret = true
}

local.file "grafana_cloud_otlp_token" {
  filename  = "/run/secrets/grafana_cloud_otlp_token"
  is_secret = true
}

local.file "grafana_cloud_loki_token" {
  filename  = "/run/secrets/grafana_cloud_loki_token"
  is_secret = true
}

local.file "grafana_cloud_profiles_token" {
  filename  = "/run/secrets/grafana_cloud_profiles_token"
  is_secret = true
}

local.file "posthog_project_token" {
  filename  = "/run/secrets/posthog_project_token"
  is_secret = true
}

local.file "nvbes_observability_internal_token" {
  filename  = "/run/secrets/nvbes_observability_internal_token"
  is_secret = true
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = local.file.grafana_cloud_prometheus_token.content
    }
  }

  external_labels = {
    environment = "production",
    platform    = "nvbes",
  }
}

prometheus.scrape "nvbes_apis" {
  targets = [
    {
      "__address__" = sys.env("NVBES_ACCOUNT_SERVICE_METRICS_TARGET"),
      "job"         = "account-service",
      "service"     = "account-service",
    },
  ]

  scrape_interval = "15s"
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]

  authorization {
    type = "Bearer"
    credentials = local.file.nvbes_observability_internal_token.content
  }
}

prometheus.scrape "nvbes_workers" {
  targets = [
    {
      "__address__" = sys.env("NVBES_ACCOUNT_WORKER_METRICS_TARGET"),
      "job"         = "account-worker",
      "service"     = "account-worker",
    },
    {
      "__address__" = sys.env("NVBES_EMAIL_WORKER_METRICS_TARGET"),
      "job"         = "email-worker",
      "service"     = "email-worker",
    },
  ]

  scrape_interval = "15s"
  metrics_path    = "/metrics"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]

  authorization {
    type = "Bearer"
    credentials = local.file.nvbes_observability_internal_token.content
  }
}

otelcol.receiver.otlp "nvbes" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.attributes.redact.input]
  }
}

otelcol.processor.attributes "redact" {
  action {
    key    = "client.address"
    action = "delete"
  }

  action {
    key    = "client.ip"
    action = "delete"
  }

  action {
    key    = "http.user_agent"
    action = "delete"
  }

  action {
    key    = "user_agent"
    action = "delete"
  }

  action {
    key    = "enduser.id"
    action = "delete"
  }

  action {
    key    = "user.id"
    action = "delete"
  }

  action {
    key    = "email"
    action = "delete"
  }

  action {
    key    = "file.name"
    action = "delete"
  }

  action {
    key    = "object_key"
    action = "delete"
  }

  output {
    traces = [otelcol.processor.tail_sampling.privacy.input]
  }
}

otelcol.processor.tail_sampling "privacy" {
  decision_wait = "10s"

  policy {
    name = "errors"
    type = "status_code"

    status_code {
      status_codes = ["ERROR"]
    }
  }

  policy {
    name = "slow_traces"
    type = "latency"

    latency {
      threshold_ms = 1000
    }
  }

  policy {
    name = "baseline"
    type = "probabilistic"

    probabilistic {
      sampling_percentage = 20
      hash_salt           = "nvbes-production"
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [
      otelcol.exporter.otlphttp.grafana_cloud.input,
      otelcol.exporter.otlphttp.posthog_traces.input,
    ]
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}

otelcol.auth.basic "grafana_cloud" {
  client_auth {
    username = sys.env("GRAFANA_CLOUD_OTLP_USER")
    password = local.file.grafana_cloud_otlp_token.content
  }
}

otelcol.exporter.otlphttp "posthog_traces" {
  traces_endpoint = sys.env("POSTHOG_OTLP_TRACES_ENDPOINT")

  client {
    endpoint = sys.env("POSTHOG_OTLP_HOST")
    auth     = otelcol.auth.bearer.posthog.handler
  }
}

otelcol.auth.bearer "posthog" {
  token = local.file.posthog_project_token.content
}

pyroscope.receive_http "nvbes" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 4040
  }

  forward_to = [pyroscope.write.grafana_cloud.receiver]
}

pyroscope.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROFILES_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROFILES_USER")
      password = local.file.grafana_cloud_profiles_token.content
    }
  }

  external_labels = {
    environment = "production",
    platform    = "nvbes",
  }
}

local.file_match "nvbes_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/nvbes/*.jsonl",
      "job"      = "nvbes-app",
    },
  ]
}

loki.source.file "nvbes" {
  targets    = local.file_match.nvbes_logs.targets
  forward_to = [loki.process.privacy.receiver]
}

loki.process "privacy" {
  stage.replace {
    expression = "(?i)\"(authorization|cookie|token|secret|password|jwt|api[_-]?key|client[_-]?secret|access_token|refresh_token|session_token|recovery_code|secret_base32)\"\\s*:\\s*\"[^\"]*\""
    replace    = "\"redacted_secret\":\"[FilteredSecret]\""
  }

  stage.replace {
    expression = "(?i)(authorization|cookie|token|secret|password|jwt|api[_-]?key|client[_-]?secret)=([^&\\s]+)"
    replace    = "[FilteredSecret]"
  }

  stage.replace {
    expression = "(?i)(Bearer|Basic)\\s+[A-Za-z0-9._~+/=-]+"
    replace    = "[FilteredAuthorization]"
  }

  stage.replace {
    expression = "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}"
    replace    = "[FilteredEmail]"
  }

  stage.replace {
    expression = "\"(client_ip|user_agent|object_key|payload|file_name|filename)\":\"[^\"]*\""
    replace    = "\"filtered\":\"[Filtered]\""
  }

  stage.replace {
    expression = "(?i)\"(query|request_body|response_body|form|headers)\"\\s*:\\s*(\"[^\"]*\"|\\{[^\\n]*\\})"
    replace    = "\"filtered_payload\":\"[Filtered]\""
  }

  stage.replace {
    expression = "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
    replace    = "[FilteredIp]"
  }

  stage.drop {
    longer_than         = "16KB"
    drop_counter_reason = "oversized_log_line"
  }

  stage.static_labels {
    values = {
      environment = "production",
      platform    = "nvbes",
    }
  }

  stage.label_keep {
    values = ["job", "environment", "platform"]
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = local.file.grafana_cloud_loki_token.content
    }
  }
}

otelcol.receiver.filelog "nvbes_posthog_logs" {
  include                    = ["/var/log/nvbes/*.jsonl"]
  start_at                   = "end"
  include_file_name          = false
  include_file_name_resolved = false
  include_file_path          = false
  include_file_path_resolved = false
  max_log_size               = "16KiB"

  resource = {
    "deployment.environment" = "production",
    "service.namespace"      = "nvbes",
    "platform"               = "nvbes",
  }

  output {
    logs = [otelcol.processor.transform.posthog_logs_privacy.input]
  }
}

otelcol.processor.transform "posthog_logs_privacy" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
      `replace_pattern(body, "(?i)\"(authorization|cookie|token|secret|password|jwt|api[_-]?key|client[_-]?secret|access_token|refresh_token|session_token|recovery_code|secret_base32)\"\\s*:\\s*\"[^\"]*\"", "\"redacted_secret\":\"[FilteredSecret]\"")`,
      `replace_pattern(body, "(?i)(authorization|cookie|token|secret|password|jwt|api[_-]?key|client[_-]?secret)=([^&\\s]+)", "[FilteredSecret]")`,
      `replace_pattern(body, "(?i)(Bearer|Basic)\\s+[A-Za-z0-9._~+/=-]+", "[FilteredAuthorization]")`,
      `replace_pattern(body, "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}", "[FilteredEmail]")`,
      `replace_pattern(body, "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "[FilteredIp]")`,
      `replace_pattern(body, "\"(client_ip|user_agent|object_key|payload|file_name|filename)\":\"[^\"]*\"", "\"filtered\":\"[Filtered]\"")`,
      `replace_pattern(body, "(?i)\"(query|request_body|response_body|form|headers)\"\\s*:\\s*(\"[^\"]*\"|\\{[^\\n]*\\})", "\"filtered_payload\":\"[Filtered]\"")`,
      `delete_key(attributes, "log.file.name")`,
      `delete_key(attributes, "log.file.path")`,
      `delete_key(attributes, "email")`,
      `delete_key(attributes, "client_ip")`,
      `delete_key(attributes, "user_agent")`,
      `delete_key(attributes, "object_key")`,
      `delete_key(attributes, "file_name")`,
      `delete_key(attributes, "filename")`,
      `delete_key(attributes, "token")`,
      `delete_key(attributes, "authorization")`,
      `limit(attributes, 80, [])`,
      `truncate_all(attributes, 2048)`,
    ]
  }

  output {
    logs = [otelcol.processor.batch.posthog_logs.input]
  }
}

otelcol.processor.batch "posthog_logs" {
  output {
    logs = [otelcol.exporter.otlphttp.posthog_logs.input]
  }
}

otelcol.exporter.otlphttp "posthog_logs" {
  logs_endpoint = sys.env("POSTHOG_OTLP_LOGS_ENDPOINT")

  client {
    endpoint = sys.env("POSTHOG_OTLP_HOST")
    auth     = otelcol.auth.bearer.posthog.handler
  }
}
