{
  "name": "identity-web",
  "projectType": "application",
  "root": "apps/identity-web",
  "sourceRoot": "apps/identity-web/src",
  "tags": ["type:app", "domain:identity", "layer:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/identity-web dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/identity-web build"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/identity-web typecheck"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/identity-web lint"
      }
    }
  }
}
