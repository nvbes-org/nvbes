{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/styles.css",
    "baseColor": "mist",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@diceui": "https://diceui.com/r/{style}/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json",
    "@intentui": "https://intentui.com/r/{name}",
    "@better-upload": "https://better-upload.com/r/{name}.json",
    "@tailark": "https://tailark.com/r/{name}.json",
    "@shadcnblocks": "https://shadcnblocks.com/r/{name}.json",
    "@tailwindadmin": "https://shadcnregistry.com/r/tailwindadmin/{name}.json"
  }
}
