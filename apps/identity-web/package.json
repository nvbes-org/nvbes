{
  "name": "@nvbes/identity-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite-plus/bin/vp dev",
    "build": "node ../../node_modules/vite-plus/bin/vp build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ../../node_modules/vite-plus/bin/vp lint src",
    "test": "node ../../node_modules/vite-plus/bin/vp test",
    "test:browser": "node test.browser.mjs",
    "format:check": "node ../../node_modules/vite-plus/bin/vp fmt --check src package.json tsconfig.json vite.config.ts index.html components.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nvbes/identity-sdk-web": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "nx": {
    "name": "identity-web",
    "tags": [
      "scope:identity",
      "type:app"
    ],
    "targets": {
      "test:browser": {
        "cache": false,
        "parallelism": false
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
