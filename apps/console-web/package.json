{
  "name": "nvbes-console-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite-plus/bin/vp dev",
    "build": "tsc -b && node ../../node_modules/vite-plus/bin/vp build && node ../../scripts/upload-grafana-sourcemaps.mjs console-web dist && node ../../scripts/remove-public-sourcemaps.mjs dist",
    "check": "pnpm run typecheck",
    "format": "node ../../node_modules/vite-plus/bin/vp fmt --write",
    "format:check": "node ../../node_modules/vite-plus/bin/vp fmt --check",
    "lint": "node ../../node_modules/vite-plus/bin/vp lint",
    "preview": "node ../../node_modules/vite-plus/bin/vp preview",
    "test": "node ../../node_modules/vite-plus/bin/vp test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@nvbes/http-client": "workspace:*",
    "@nvbes/identity-client": "workspace:*",
    "@nvbes/identity-sdk": "workspace:*",
    "@nvbes/identity-sdk-web": "workspace:*",
    "@nvbes/web-runtime": "workspace:*",
    "@nvbes/web-ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "catalog:"
  }
}
