{
  "name": "drive-api",
  "projectType": "application",
  "root": "apps/drive-api",
  "sourceRoot": "apps/drive-api/src",
  "tags": ["type:app", "domain:drive", "layer:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --manifest-path apps/drive-api/Cargo.toml"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check --manifest-path apps/drive-api/Cargo.toml"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path apps/drive-api/Cargo.toml"
      }
    }
  }
}
