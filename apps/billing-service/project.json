{
  "name": "billing-service",
  "projectType": "application",
  "root": "apps/billing-service",
  "sourceRoot": "apps/billing-service/src",
  "implicitDependencies": ["identity-sdk-backend"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/libs/rust/billing/**/*",
        "{workspaceRoot}/libs/rust/core/**/*",
        "{workspaceRoot}/libs/rust/dpop/**/*",
        "{workspaceRoot}/libs/rust/email/**/*",
        "{workspaceRoot}/libs/rust/identity-sdk-backend/**/*",
        "{workspaceRoot}/libs/rust/observability/**/*"
      ],
      "options": {
        "command": "cargo check --locked --package nvbes-billing-service --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo nextest run --locked --package nvbes-billing-service",
        "cwd": "."
      }
    },
    "test:contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/Dockerfile", "{projectRoot}/tests/**/*", "{projectRoot}/src/**/*"],
      "options": {
        "command": "node --test apps/billing-service/tests/container-contract.test.mjs",
        "cwd": "."
      }
    },
    "test:database": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "bash scripts/test-billing-service-database.sh",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:platform", "type:app", "domain:billing", "layer:app"]
}
