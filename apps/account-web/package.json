{
  "name": "nvbes-account-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite-plus/bin/vp dev",
    "build": "tsc -b && node ../../node_modules/vite-plus/bin/vp build && node ../../scripts/upload-grafana-sourcemaps.mjs account-web dist && node ../../scripts/remove-public-sourcemaps.mjs dist",
    "check": "pnpm run typecheck",
    "preview": "node ../../node_modules/vite-plus/bin/vp preview --mode production",
    "typecheck": "tsc -b --pretty false",
    "lint": "node ../../node_modules/vite-plus/bin/vp lint",
    "format": "node ../../node_modules/vite-plus/bin/vp fmt --write",
    "format:check": "node ../../node_modules/vite-plus/bin/vp fmt --check",
    "test": "node ../../node_modules/vite-plus/bin/vp test run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@grafana/faro-web-tracing": "^2.9.0",
    "@nvbes/account-client": "workspace:*",
    "@nvbes/identity-sdk-web": "workspace:*",
    "@nvbes/web-runtime": "workspace:*",
    "@nvbes/web-ui": "workspace:*",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@sentry/browser": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.28.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.16.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "catalog:"
  }
}
