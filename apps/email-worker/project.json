{
  "name": "email-worker",
  "projectType": "application",
  "root": "apps/email-worker",
  "sourceRoot": "apps/email-worker/src",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/contracts/protobuf/nvbes/email/**/*",
        "{workspaceRoot}/libs/rust/email/**/*",
        "{workspaceRoot}/libs/rust/observability/**/*",
        "{workspaceRoot}/libs/rust/adapters-cloud/email-scaleway/**/*"
      ],
      "options": {
        "command": "cargo check --locked --package nvbes-email-worker --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test --locked --package nvbes-email --package nvbes-email-worker --package nvbes-email-scaleway",
        "cwd": "."
      }
    },
    "test:database": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/test-email-worker-database.sh",
        "cwd": "."
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/migrations/*.sql",
        "{projectRoot}/src/*.rs",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/scripts/test-email-worker-coverage.sh",
        "{workspaceRoot}/scripts/lib/test-env.sh",
        "{workspaceRoot}/scripts/lib/workspace-env.sh",
        "{workspaceRoot}/scripts/validate-email-test-database.mjs"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-email-worker-coverage.sh",
        "cwd": "."
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/migrations/*.sql",
        "{projectRoot}/src/*.rs",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/scripts/test-email-worker-e2e.sh",
        "{workspaceRoot}/scripts/lib/test-env.sh",
        "{workspaceRoot}/scripts/lib/workspace-env.sh",
        "{workspaceRoot}/scripts/validate-email-test-database.mjs"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-email-worker-e2e.sh",
        "cwd": "."
      }
    },
    "container-contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "node --test apps/email-worker/tests/container-contract.test.mjs",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:platform", "type:app", "domain:email", "layer:app"]
}
