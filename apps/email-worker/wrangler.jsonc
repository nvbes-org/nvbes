{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nvbes-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "nvbes-email-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "nvbes-email-worker-production",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
