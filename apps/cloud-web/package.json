{
  "name": "nvbes-cloud-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite-plus/bin/vp dev",
    "build": "tsc -b && node ../../node_modules/vite-plus/bin/vp build && node ../../scripts/upload-grafana-sourcemaps.mjs cloud-web dist && node ../../scripts/remove-public-sourcemaps.mjs dist",
    "check": "pnpm run typecheck",
    "format": "node ../../node_modules/vite-plus/bin/vp fmt --write",
    "format:check": "node ../../node_modules/vite-plus/bin/vp fmt --check",
    "lint": "node ../../node_modules/vite-plus/bin/vp lint",
    "preview": "node ../../node_modules/vite-plus/bin/vp preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-upload/client": "^3.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@nvbes/identity-sdk": "workspace:*",
    "@nvbes/web-runtime": "workspace:*",
    "@nvbes/web-ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-aria-components": "^1.20.0",
    "react-dom": "catalog:",
    "react-dropzone": "^15.0.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nvbes/http-client": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "catalog:",
    "globals": "^17.9.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "catalog:",
