  "components": {
    "schemas": {
      "AccountConsent": {
        "type": "object",
        "required": [
          "id",
          "principal_id",
          "consent_type",
          "document_version",
          "granted_at"
        ],
        "properties": {
          "consent_type": {
            "type": "string"
          },
          "document_version": {
            "type": "string"
          },
          "granted_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ip_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "principal_id": {
            "type": "string",
            "format": "uuid"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "AccountLanguage": {
        "type": "string",
        "enum": [
          "fr",
          "en"
        ]
      },
      "AccountNotifications": {
        "type": "object",
        "required": [
          "email",
          "push",
          "in_app",
          "marketing_email"
        ],
        "properties": {
          "email": {
            "type": "boolean"
          },
          "in_app": {
            "type": "boolean"
          },
          "marketing_email": {
            "type": "boolean"
          },
          "push": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AccountPreferences": {
        "type": "object",
        "required": [
          "theme",
          "language"
        ],
        "properties": {
          "language": {
            "$ref": "#/components/schemas/AccountLanguage"
          },
          "theme": {
            "$ref": "#/components/schemas/AccountTheme"
          }
        },
        "additionalProperties": false
      },
      "AccountProfile": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "created_at"
        ],
        "properties": {
          "birthdate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "firstname": {
