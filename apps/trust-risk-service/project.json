{
  "name": "trust-risk-service",
  "projectType": "application",
  "root": "apps/trust-risk-service",
  "sourceRoot": "apps/trust-risk-service/src",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/contracts/protobuf/nvbes/trust_risk/**/*",
        "{workspaceRoot}/libs/rust/trust-risk/**/*",
        "{workspaceRoot}/libs/rust/observability/**/*"
      ],
      "options": {
        "command": "cargo check --locked --package nvbes-trust-risk-service --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test --locked --package nvbes-trust-risk --package nvbes-trust-risk-service",
        "cwd": "."
      }
    },
    "test:database": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": {
        "command": "bash scripts/test-trust-risk-service-database.sh",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:platform", "type:app", "domain:trust-risk", "layer:app"]
}
