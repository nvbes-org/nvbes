{
  "name": "identity-service",
  "projectType": "application",
  "root": "apps/identity-service",
  "sourceRoot": "apps/identity-service/src",
  "tags": [
    "scope:oss",
    "type:app",
    "domain:identity",
    "layer:app"
  ],
  "namedInputs": {
    "rustSources": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/apps/**/Cargo.toml",
      "{workspaceRoot}/libs/rust/**/Cargo.toml",
      "{workspaceRoot}/libs/rust/**/src/**/*",
      "{workspaceRoot}/vendor/xmlsec/**/*",
      {
        "runtime": "rustc --version --verbose"
      },
      {
        "runtime": "cargo --version"
      }
    ],
    "rustTests": [
      "rustSources",
      {
        "env": "DATABASE_URL"
      },
      {
        "env": "NVBES_DATABASE_URL"
      },
      {
        "env": "NVBES_REDIS_URL"
      },
      {
        "env": "NVBES_REDIS_PASSWORD"
      },
      {
        "env": "NVBES_ALLOW_DESTRUCTIVE_TEST_DATABASE"
      }
    ]
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources"],
      "outputs": [],
      "options": {
        "command": "cargo check --package nvbes-identity-service --all-targets --locked",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources"],
      "outputs": [],
      "options": {
        "command": "cargo build --package nvbes-identity-service --release --locked",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "inputs": [
        "rustTests",
        "{workspaceRoot}/scripts/test-identity-service.sh",
        "{workspaceRoot}/scripts/lib/test-env.sh",
        "{workspaceRoot}/scripts/lib/workspace-env.sh",
        "{workspaceRoot}/scripts/lib/validate-destructive-test-database.mjs",
        "{workspaceRoot}/scripts/lib/validate-test-redis-target.mjs"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-identity-service.sh",
        "cwd": "."
      }
    },
    "test-contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rustSources",
        "{workspaceRoot}/scripts/test-identity-service-contract.sh",
        "{workspaceRoot}/apps/identity-service/openapi.json",
        "{workspaceRoot}/libs/ts/identity-sdk-core/openapi.json",
        "{workspaceRoot}/libs/ts/identity-sdk-core/openapi.contract.test.mjs",
        "{workspaceRoot}/libs/ts/identity-sdk-core/src/types.gen.ts"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-identity-service-contract.sh",
        "cwd": "."
      }
    },
    "test-security": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rustTests",
        "{workspaceRoot}/scripts/test-identity-service-security.sh",
        "{workspaceRoot}/scripts/test-identity-service.sh",
        "{workspaceRoot}/scripts/lib/test-env.sh",
        "{workspaceRoot}/scripts/lib/workspace-env.sh",
        "{workspaceRoot}/scripts/lib/validate-destructive-test-database.mjs",
        "{workspaceRoot}/scripts/lib/validate-test-redis-target.mjs"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-identity-service-security.sh",
        "cwd": "."
      }
    },
    "test-migrations": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "rustTests",
        "{workspaceRoot}/scripts/test-identity-service-migrations.sh"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-identity-service-migrations.sh",
        "cwd": "."
      }
    }
  }
}
