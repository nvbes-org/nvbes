{
  "name": "nvbes",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm dev:email-worker",
    "dev:email-worker": "bash scripts/dev-email-worker.sh",
    "dev:infra": "docker compose --profile infra -f infrastructure/local/docker-compose.yml up -d",
    "dev:infra:down": "docker compose --profile infra -f infrastructure/local/docker-compose.yml down",
    "dev:infra:obs": "docker compose --profile observability -f infrastructure/local/docker-compose.yml up -d",
    "dev:infra:obs:beyla": "docker compose --profile observability --profile beyla -f infrastructure/local/docker-compose.yml up alloy-beyla",
    "dev:infra:obs:k6:identity": "docker compose --profile observability --profile loadtest -f infrastructure/local/docker-compose.yml run --rm k6-identity-smoke",
    "dev:infra:full": "docker compose --profile full -f infrastructure/local/docker-compose.yml up -d",
    "env:check": "node scripts/env.mjs check && node --test scripts/env.test.mjs",
    "env:sync": "node scripts/env.mjs sync",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:migrate:billing": "bash scripts/db-migrate-billing.sh",
    "db:migrate:staging": "bash scripts/migrate-staging.sh",
    "clean:caches": "bash scripts/clean-caches.sh",
    "cache:manage": "bash scripts/cache-manager.sh",
    "build": "pnpm generate:email && pnpm exec nx run-many -t build --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui && pnpm exec nx run rust-workspace:build",
    "generate:email": "pnpm exec nx run email-ui:generate",
    "generate:openapi": "bash scripts/generate-openapi.sh",
    "doc:extract": "node tools/doc-system/extract-workspace-ir.mjs",
    "doc:generate": "node tools/doc-system/generate-deterministic-docs.mjs",
    "doc:ai-enrich": "node tools/doc-system/generate-ai-doc.mjs",
    "doc:agent-context": "node tools/doc-system/generate-agent-context.mjs",
    "doc:test-snippets": "node tools/doc-system/test-code-blocks.mjs",
    "doc:check-drift": "node tools/doc-system/check-doc-drift.mjs",
    "doc:validate": "node tools/doc-system/validate-docs.mjs",
    "doc:update-service": "node tools/doc-system/update-service-doc.mjs",
    "doc:fix": "node tools/doc-system/fix-docs.mjs",
    "doc:watch": "node tools/doc-system/watch-docs.mjs",
    "dev:docs": "node tools/doc-system/watch-docs.mjs",
    "build:docs": "node tools/doc-system/extract-workspace-ir.mjs && node tools/doc-system/generate-deterministic-docs.mjs && node tools/doc-system/generate-agent-context.mjs && node tools/doc-system/validate-docs.mjs",
    "check": "pnpm env:check && pnpm check:structure && pnpm check:secrets && pnpm check:finops && pnpm check:web && pnpm check:api",
    "check:dev-runtime": "node --test scripts/dev-runtime.test.mjs",
    "check:api": "pnpm exec nx run rust-workspace:check",
    "check:backoffice-service": "pnpm check:backoffice-service-openapi && cargo test -p nvbes-backoffice-service openapi && cargo check -p nvbes-backoffice-service && pnpm exec nx run backoffice-web:format:check && pnpm exec nx run backoffice-web:check && pnpm test:backoffice-web:e2e:mocked",
    "check:backoffice-service-openapi": "node scripts/check-backoffice-service-openapi.mjs",
    "check:web": "pnpm check:web-runtime-guardrails && pnpm check:ajax-security && pnpm exec nx run email-ui:check && pnpm exec nx run-many -t format:check --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui,email-ui && pnpm exec nx run-many -t lint --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui,email-ui && pnpm exec nx run-many -t typecheck --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui,email-ui && vp check package.json pnpm-workspace.yaml vite.config.ts tsconfig.base.json nx.json",
    "check:web-runtime-guardrails": "node scripts/check-web-runtime-guardrails.mjs",
    "check:ajax-security": "node scripts/check-ajax-security.mjs",
    "check:security": "pnpm check:secrets && pnpm check:abuse-cases && pnpm check:authentication && pnpm check:authorization && pnpm check:authorization-regression && pnpm check:authorization-testing-automation && pnpm check:bot-management && pnpm check:business-logic-security && pnpm check:c-toolchain-hardening && pnpm check:ci-cd-security && pnpm check:content-security-policy && pnpm check:cookie-theft-mitigation && pnpm check:credential-stuffing-prevention && pnpm check:cross-site-request-forgery-prevention && pnpm check:cross-site-scripting-prevention && pnpm check:supply-chain",
    "check:authorization": "node tools/security/check-authorization-controls.mjs",
    "check:authorization-regression": "node tools/security/check-authorization-regression-tests.mjs",
    "check:authorization-testing-automation": "node tools/security/check-authorization-testing-automation.mjs",
    "check:bot-management": "node tools/security/check-bot-management-controls.mjs",
    "check:business-logic-security": "node tools/security/check-business-logic-security.mjs",
    "check:c-toolchain-hardening": "node tools/security/check-c-toolchain-hardening.mjs",
    "check:ci-cd-security": "node tools/security/check-ci-cd-security.mjs && node tools/security/check-compliance-standards.mjs && node tools/security/check-production-security-operations.mjs",
    "check:account-acceptance-evidence": "node tools/account-quality/verify-acceptance-evidence.mjs",
    "check:account-production-target": "node tools/account-quality/check-production-account-target.mjs",
    "check:account-release-readiness": "node tools/account-quality/check-account-release-readiness.mjs",
    "check:production-security-operations": "node tools/security/check-production-security-operations.mjs",
    "check:fapi-conformance": "node tools/security/check-fapi-conformance-evidence.mjs",
    "check:finops": "pnpm check:finops-production-budget && pnpm check:finops-scale-to-zero && pnpm check:finops-workflows",
    "check:finops-production-budget": "node --test tools/finops/production-budget.test.mjs && node tools/finops/check-production-budget.mjs",
    "check:finops-scale-to-zero": "node --test tools/finops/check-scale-to-zero.test.mjs tools/finops/check-scale-to-zero.modules.test.mjs && node tools/finops/check-scale-to-zero.mjs",
    "check:finops-workflows": "node --test tools/ci/finops-workflows-contract.test.mjs tools/ci/finops-workflows-contract.adversarial.test.mjs tools/ci/finops-workflows-context.adversarial.test.mjs tools/ci/scaleway-ci-cache-contract.test.mjs",
    "check:compliance-standards": "node tools/security/check-compliance-standards.mjs",
    "check:content-security-policy": "node tools/security/check-content-security-policy.mjs",
    "check:cookie-theft-mitigation": "node tools/security/check-cookie-theft-mitigation.mjs",
    "check:credential-stuffing-prevention": "node tools/security/check-credential-stuffing-prevention.mjs",
    "check:cross-site-request-forgery-prevention": "node tools/security/check-cross-site-request-forgery-prevention.mjs",
    "check:cross-site-scripting-prevention": "node tools/security/check-cross-site-scripting-prevention.mjs",
    "check:structure": "bash scripts/check-llm-structure.sh",
    "check:nx-boundaries": "node scripts/check-nx-boundaries.mjs",
    "check:contracts": "node tools/contracts/checks.mjs",
    "check:codegen": "node tools/codegen/checks.mjs",
    "check:product-boundaries": "node tools/boundary-checks/check-product-boundaries.mjs",
    "check:secrets": "node tools/security/scan-secrets.mjs",
    "check:abuse-cases": "node tools/security/check-abuse-cases.mjs",
    "check:authentication": "node tools/security/check-authentication-controls.mjs",
    "check:dependencies": "node tools/security/check-dependencies.mjs",
    "check:sbom": "node tools/security/sbom.mjs",
    "check:containers": "node tools/security/check-containers.mjs",
    "check:supply-chain": "pnpm check:secrets && pnpm check:dependencies && pnpm check:sbom && pnpm check:containers",
    "security:osv": "docker run --rm -v \"$PWD:/src\" ghcr.io/google/osv-scanner@sha256:64e86bec6df2466feea5137fc7c78fb3b7c21ec077f014d7130f64810e50676b scan source --lockfile /src/Cargo.lock --lockfile /src/pnpm-lock.yaml --config /src/.osv-scanner.toml",
    "security:cargo-deny": "cargo deny --all-features check",
    "security:gitleaks-history": "docker run --rm -v \"$PWD:/repo\" ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f detect --source=/repo --log-opts=--all --redact",
    "security:trivy": "docker run --rm -v \"$PWD:/workspace\" ghcr.io/aquasecurity/trivy@sha256:be1190afcb28352bfddc4ddeb71470835d16462af68d310f9f4bca710961a41e fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 1 --skip-dirs .git,.nx,.pnpm-store,.temp,node_modules,target,infrastructure/local/observability/app-logs /workspace",
    "security:fuzz": "cargo fuzz run dpop_proof -- -max_total_time=30 && cargo fuzz run oauth_authorization_details -- -max_total_time=30 && cargo fuzz run upload_inputs -- -max_total_time=30",
    "agent:sync": "node scripts/agent/sync-instructions.mjs",
    "agent:skills": "node scripts/agent/index-skills.mjs",
    "agent:research": "node scripts/agent/index-research.mjs",
    "agent:doctor": "node scripts/agent/agent-doctor.mjs",
    "nx:show-projects": "pnpm exec nx show projects --json",
    "nx:show-project": "pnpm exec nx show project",
    "nx:affected": "pnpm exec nx affected -t lint,typecheck,test,build --base=origin/main --head=HEAD",
    "format": "vp fmt --write libs/ts package.json pnpm-workspace.yaml vite.config.ts && cargo fmt --all",
    "format:check": "pnpm exec nx run-many -t format:check --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui,email-ui && vp fmt --check package.json pnpm-workspace.yaml vite.config.ts tsconfig.base.json nx.json && cargo fmt --all --check",
    "lint": "pnpm lint:web && pnpm exec nx run rust-workspace:lint",
    "lint:web": "pnpm exec nx run-many -t lint --projects=http-client,account-client,billing-client,identity-client,identity-sdk,identity-sdk-web,web-runtime,web-ui,email-ui",
    "test": "pnpm exec nx run email-worker:test",
    "test:pre-build": "pnpm format:check && pnpm check:structure && pnpm check:nx-boundaries && pnpm check:contracts && pnpm lint && pnpm test:unit",
    "test:post-build": "node --test apps/email-worker/tests/container-contract.test.mjs",
    "test:pre-deploy": "node --test tools/ci/email-deployment-contract.test.mjs && terraform fmt -check -recursive infrastructure/environments/email-production infrastructure/stacks/email/production",
    "test:post-deploy": "bash scripts/test-smoke.sh",
    "test:unit": "bash scripts/test-unit.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "test:email:coverage": "bash scripts/test-email-coverage.sh",
    "test:e2e:critical": "bash scripts/test-e2e-critical.sh",
    "test:e2e:critical:local": "pnpm exec nx run identity-web:test:e2e:critical:local",
    "test:smoke:contract": "bash scripts/test-openapi-contract.sh",
    "test:smoke:contract:seeded-auth": "bash scripts/test-openapi-contract-seeded-auth.sh",
    "test:smoke": "bash scripts/test-smoke.sh",
    "test:smoke:staging": "bash scripts/smoke-staging.sh",
    "check:stripe-mappings": "bash scripts/check-stripe-mappings.sh",
    "release:gate:staging": "bash scripts/release-gate.sh staging",
    "release:gate:production": "bash scripts/release-gate.sh production",
    "verify": "pnpm format:check && pnpm check:structure && pnpm check:nx-boundaries && pnpm lint && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@cdktn/hcl2json": "0.24.0",
    "@grafana/faro-cli": "^0.11.0",
    "@grafana/faro-rollup-plugin": "^0.11.0",
    "@posthog/cli": "^0.9.4",
    "@sentry/vite-plugin": "^5.4.0",
    "nx": "^23.1.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.18.0",
    "terser": "^5.50.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "wrangler": "4.114.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0 || >=26.0.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.18.0"
}
