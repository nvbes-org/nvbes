{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/identity/id-token.v1.schema.json",
  "title": "Identity OIDC ID token v1",
  "description": "RS256 JWT (typ JWT) for the OIDC client. This token is never an API credential. Public subject identifiers; no pairwise or assurance-level claim is advertised.",
  "type": "object",
  "required": ["iss", "sub", "aud", "exp", "iat", "auth_time", "amr", "nonce", "sid", "at_hash"],
  "properties": {
    "iss": { "type": "string", "format": "uri" },
    "sub": { "type": "string", "format": "uuid" },
    "aud": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "description": "Registered OIDC client ID; distinct from the API audience."
    },
    "exp": { "type": "integer", "minimum": 1 },
    "iat": { "type": "integer", "minimum": 0 },
    "auth_time": { "type": "integer", "minimum": 0 },
    "amr": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["pwd", "totp", "webauthn"] },
      "contains": { "enum": ["pwd", "webauthn"] }
    },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 512 },
    "sid": { "type": "string", "format": "uuid" },
    "at_hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "Base64url of the left half of SHA-256 over the access token."
    }
  },
  "additionalProperties": false
}
