{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.com/events/billing.invoice.issued.v1.schema.json",
  "title": "billing.invoice.issued.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "event_version", "payload"],
  "properties": {
    "event_type": { "const": "billing.invoice.issued" },
    "event_version": { "const": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "invoice_id",
        "invoice_number",
        "currency",
        "subtotal_minor",
        "tax_minor",
        "total_minor",
        "issued_at"
      ],
      "properties": {
        "tenant_id": { "type": "string", "format": "uuid" },
        "invoice_id": { "type": "string", "format": "uuid" },
        "invoice_number": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "subtotal_minor": { "type": "integer", "minimum": 0 },
        "tax_minor": { "type": "integer", "minimum": 0 },
        "total_minor": { "type": "integer", "minimum": 0 },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
