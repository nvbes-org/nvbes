{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/enterprise.policy.changed.v1.schema.json",
  "title": "enterprise.policy.changed v1",
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "payload"
  ],
  "properties": {
    "event_type": {
      "const": "enterprise.policy.changed"
    },
    "event_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "tenant_id",
        "policy_id",
        "policy_kind",
        "changed_at"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "policy_id": {
          "type": "string",
          "format": "uuid"
        },
        "policy_kind": {
          "type": "string",
          "minLength": 1
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
