{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/platform.operator_action.recorded.v1.schema.json",
  "title": "nvbes Platform Operator Action Recorded Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "operator_id",
    "action_type",
    "idempotency_key",
    "correlation_id",
    "executed_at",
    "status",
    "details",
    "reason",
    "is_reversible"
  ],
  "properties": {
    "receipt_id": { "type": "string", "format": "uuid" },
    "operator_id": { "type": "string", "minLength": 3 },
    "action_type": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "format": "uuid" },
    "executed_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["executed", "failed", "pending"] },
    "details": { "type": "string" },
    "reason": { "type": "string", "minLength": 3, "maxLength": 300 },
    "is_reversible": { "type": "boolean" },
    "reversal_instruction": { "type": ["string", "null"] }
  }
}
