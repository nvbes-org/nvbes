{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/account.team.member_left.v1.schema.json",
  "title": "account.team.member_left v1",
  "type": "object",
  "required": ["event_type", "event_version", "payload"],
  "properties": {
    "event_type": { "const": "account.team.member_left" },
    "event_version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["team_id", "principal_id", "actor_principal_id"],
      "properties": {
        "team_id": { "type": "string", "format": "uuid" },
        "principal_id": { "type": "string", "format": "uuid" },
        "actor_principal_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
