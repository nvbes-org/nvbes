{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/billing.entitlement.changed.v1.schema.json",
  "title": "billing.entitlement.changed v1",
  "type": "object",
  "required": ["event_type", "event_version", "payload"],
  "properties": {
    "event_type": { "const": "billing.entitlement.changed" },
    "event_version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["workspace_id", "entitlement", "status"],
      "properties": {
        "workspace_id": { "type": "string", "format": "uuid" },
        "entitlement": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      }
    }
  }
}
