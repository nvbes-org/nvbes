{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/README.md",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/docs/**",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/dist/**",
      "!{projectRoot}/coverage/**",
      "!{projectRoot}/playwright-report/**",
      "!{projectRoot}/test-results/**",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/e2e/**",
      "!{projectRoot}/README.md",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/docs/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/vite.config.ts"
    ]
  },
  "parallel": 4,
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "check": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "dev": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "preview": {
      "cache": false
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production"]
    }
  },
  "analytics": false,
  "nxCloudId": "6a3bfc09a9d6ced97d0c39c1"
}
