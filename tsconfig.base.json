{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@nvbes/http-client": ["./libs/ts/http-client/src/index.ts"],
      "@nvbes/account-client": ["./libs/ts/account-client/src/index.ts"],
      "@nvbes/billing-client": ["./libs/ts/billing-client/src/index.ts"],
      "@nvbes/identity-client": ["./libs/ts/identity-client/src/index.ts"],
      "@nvbes/identity-sdk": ["./libs/ts/identity-sdk/src/index.ts"],
      "@nvbes/identity-sdk-web": ["./libs/ts/identity-sdk-web/src/index.ts"],
      "@nvbes/web-runtime": ["./libs/ts/web-runtime/src/index.ts"],
      "@nvbes/web-ui": ["./libs/ts/web-ui/src/index.ts"],
      "@nvbes/email-ui": ["./libs/ts/email-ui/src/index.ts"]
    },
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite-plus/client"]
  }
}
