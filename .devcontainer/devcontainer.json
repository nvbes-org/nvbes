{
  "name": "nvbes full-stack dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/nvbes",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/open-start-page.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [
    3001, 4000, 4002, 5173, 11025, 15432, 16379, 18025, 18333
  ],
  "portsAttributes": {
    "3001": {
      "label": "Identity web"
    },
    "4000": {
      "label": "Identity API"
    },
    "4002": {
      "label": "Drive API"
    },
    "5173": {
      "label": "Drive web"
    },
    "15432": {
      "label": "PostgreSQL"
    },
    "16379": {
      "label": "Redis"
    },
    "18333": {
      "label": "SeaweedFS S3"
    },
    "18025": {
      "label": "MailHog"
    },
    "11025": {
      "label": "MailHog SMTP"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "extensions.ignoreRecommendations": true,
        "nxConsole.generateAiAgentRules": false,
        "rust-analyzer.cargo.allTargets": false,
        "rust-analyzer.cargo.features": [],
        "rust-analyzer.check.allTargets": false,
        "rust-analyzer.files.excludeDirs": [
          ".git",
          "node_modules",
          "target"
        ],
        "rust-analyzer.lru.capacity": 128,
        "typescript.disableAutomaticTypeAcquisition": true,
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.tsserver.maxTsServerMemory": 1024,
        "typescript.tsserver.useSeparateSyntaxServer": false
      }
    }
  }
}
