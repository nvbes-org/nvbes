{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nvbes.local/migration/reconciliation-report.schema.json",
  "title": "nvbes Migration Reconciliation Report",
  "type": "object",
  "required": ["schema_version", "environment", "snapshot_id", "target", "durations_seconds", "domains", "decision"],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["commit", "contracts_version"],
      "properties": {
        "commit": { "type": "string", "minLength": 1 },
        "contracts_version": { "type": "string", "minLength": 1 },
        "image_digests": { "type": "array", "items": { "type": "string" } },
        "migration_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "durations_seconds": {
      "type": "object",
      "required": ["export", "transform", "import", "reconciliation"],
      "properties": {
        "export": { "type": "number", "minimum": 0 },
        "transform": { "type": "number", "minimum": 0 },
        "import": { "type": "number", "minimum": 0 },
        "reconciliation": { "type": "number", "minimum": 0 },
        "smoke": { "type": "number", "minimum": 0 }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "counts", "checksums", "orphans", "duplicates", "rejects", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "counts": {
            "type": "object",
            "required": ["source_rows", "target_rows", "delta"],
            "properties": {
              "source_rows": { "type": "integer", "minimum": 0 },
              "target_rows": { "type": "integer", "minimum": 0 },
              "delta": { "type": "integer" }
            }
          },
          "checksums": {
            "type": "object",
            "required": ["matched"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" },
              "matched": { "type": "boolean" }
            }
          },
          "orphans": { "type": "integer", "minimum": 0 },
          "duplicates": { "type": "integer", "minimum": 0 },
          "rejects": {
            "type": "object",
            "required": ["fixed", "accepted", "rejected", "blocking"],
            "properties": {
              "fixed": { "type": "integer", "minimum": 0 },
              "accepted": { "type": "integer", "minimum": 0 },
              "rejected": { "type": "integer", "minimum": 0 },
              "blocking": { "type": "integer", "minimum": 0 }
            }
          },
          "status": { "enum": ["passed", "accepted", "blocking"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decision": { "enum": ["go", "no-go", "go-with-accepted-rejects"] }
  }
}
