{
  "schemaVersion": 1,
  "owner": "Security and Compliance",
  "reviewCadence": "Quarterly, before production releases, after material architecture changes, and after security incidents.",
  "communicationsPolicy": {
    "allowedClaim": "Controls are internally mapped to the listed standards.",
    "prohibitedClaims": ["certified", "externally attested", "fully compliant"],
    "exception": "A prohibited claim requires a current certificate, attestation report, or signed legal applicability opinion referenced from the evidence register."
  },
  "profiles": [
    {
      "id": "NVBES_BASELINE",
      "scope": ["all internet-facing applications", "all public and internal APIs"],
      "asvsLevel": 2,
      "aal": "risk-based",
      "phishingResistant": false
    },
    {
      "id": "NVBES_CRITICAL",
      "scope": ["Account", "Backoffice", "Billing", "privileged operations"],
      "asvsLevel": 3,
      "aal": "AAL2",
      "phishingResistant": true
    }
  ],
  "frameworks": [
    {
      "id": "OWASP-ASVS-5.0.0",
      "source": "https://owasp.org/www-project-application-security-verification-standard/",
      "target": "Level 2 baseline and Level 3 critical profile",
      "claimStatus": "internal-alignment",
      "externalAssuranceRequired": false
    },
    {
      "id": "NIST-SP-800-63-4",
      "source": "https://pages.nist.gov/800-63-4/",
      "target": "AAL2 default for sensitive account activity and phishing-resistant authentication for privileged activity",
      "claimStatus": "internal-alignment",
      "externalAssuranceRequired": false
    },
    {
      "id": "OAUTH-OIDC-FAPI",
      "source": "https://datatracker.ietf.org/doc/html/rfc9700",
      "relatedSources": [
        "https://openid.net/specs/openid-connect-core-1_0.html",
        "https://datatracker.ietf.org/doc/html/rfc8725",
        "https://datatracker.ietf.org/doc/html/rfc9126",
        "https://datatracker.ietf.org/doc/html/rfc9101",
        "https://datatracker.ietf.org/doc/html/rfc9449",
        "https://datatracker.ietf.org/doc/html/rfc8705",
        "https://openid.net/specs/fapi-security-profile-2_0-final.html"
      ],
      "target": "RFC 9700 baseline with OIDC, JWT BCP, PAR, JAR, DPoP or mTLS and FAPI 2.0 for high assurance",
      "claimStatus": "internal-alignment",
      "externalAssuranceRequired": false
    },
    {
      "id": "NIST-CSF-2.0-CIS-8.1",
      "source": "https://www.nist.gov/cyberframework",
      "relatedSources": ["https://www.cisecurity.org/controls/v8-1"],
      "target": "Security governance and operational control baseline",
      "claimStatus": "internal-alignment",
      "externalAssuranceRequired": false
    },
    {
      "id": "ISO-27001-27017-27018",
      "source": "https://www.iso.org/standard/27001",
      "relatedSources": [
        "https://www.iso.org/standard/82878.html",
        "https://www.iso.org/standard/27018"
      ],
      "target": "ISO/IEC 27001:2022 ISMS with cloud and public-cloud PII control extensions",
      "claimStatus": "target",
      "externalAssuranceRequired": true
    },
    {
      "id": "GDPR-CNIL",
      "source": "https://www.cnil.fr/fr/guide-de-la-securite-des-donnees-personnelles",
      "relatedSources": ["https://eur-lex.europa.eu/eli/reg/2016/679/oj"],
      "target": "Applicable privacy, security, data-subject-rights and accountability obligations",
      "claimStatus": "applicable",
      "externalAssuranceRequired": false
    },
    {
      "id": "PCI-DSS-4.0.1",
      "source": "https://www.pcisecuritystandards.org/standards/pci-dss/",
      "target": "Minimized SAQ A-oriented scope through provider-hosted Checkout and Portal",
      "claimStatus": "scope-minimized",
      "externalAssuranceRequired": true
    },
    {
      "id": "SOC2-TYPE-II",
      "source": "https://www.aicpa-cima.com/resources/download/2017-trust-services-criteria-with-revised-points-of-focus-2022",
      "target": "Type II attestation after a stable control observation period",
      "claimStatus": "target",
      "externalAssuranceRequired": true
    },
    {
      "id": "NIS2-CRA",
      "source": "https://eur-lex.europa.eu/eli/dir/2022/2555/oj",
      "relatedSources": ["https://eur-lex.europa.eu/eli/reg/2024/2847/oj"],
      "target": "Documented legal applicability decisions for NIS2 and Regulation (EU) 2024/2847",
      "claimStatus": "applicability-review",
      "externalAssuranceRequired": true
    }
  ],
  "controls": [
    {
      "id": "STD_CTRL_001",
      "name": "Application security verification profiles",
      "status": "implemented",
      "profiles": ["NVBES_BASELINE", "NVBES_CRITICAL"],
      "frameworks": ["OWASP-ASVS-5.0.0"],
      "evidence": [
        {
          "path": "docs/security/authentication-controls.json",
          "includes": ["AUTHN_CTRL_021", "AUTHN_CTRL_022"]
        },
        {
          "path": "docs/security/authorization-controls.json",
          "includes": ["AUTHZ_CTRL_006", "AUTHZ_CTRL_007"]
        },
        {
          "path": "package.json",
          "includes": ["check:authentication", "check:authorization", "check:ci-cd-security"]
        }
      ]
    },
    {
      "id": "STD_CTRL_002",
      "name": "AAL2 authentication and bounded step-up",
      "status": "implemented",
      "profiles": ["NVBES_CRITICAL"],
      "frameworks": ["NIST-SP-800-63-4", "OWASP-ASVS-5.0.0"],
      "evidence": [
        {
          "path": "libs/rust/core/src/auth.assurance.rs",
          "includes": ["has_recent_phishing_resistant_authentication", "Aal::Aal2"]
        },
        {
          "path": "apps/identity-service/src/identity.mfa.rs",
          "includes": ["step_up_expires_at", "grant_step_up", "step_up_granted"]
        }
      ]
    },
    {
      "id": "STD_CTRL_003",
      "name": "Phishing-resistant privileged authentication policy",
      "status": "implemented",
      "profiles": ["NVBES_CRITICAL"],
      "frameworks": ["NIST-SP-800-63-4", "OWASP-ASVS-5.0.0"],
      "target": "Production activation is blocked until live evidence is signed in external-security-assurance.json",
      "evidence": [
        {
          "path": "libs/rust/core/src/auth.assurance.rs",
          "includes": [
            "has_recent_phishing_resistant_authentication",
            "webauthn",
            "passkey",
            "security_key"
          ]
        },
        {
          "path": "libs/rust/platform/src/platform.cockpit.auth.rs",
          "includes": ["DEFAULT_OPERATOR_ROLE", "MFA_STEP_UP_HEADER", "has_mfa_step_up"]
        },
        {
          "path": "tools/security/check-production-security-operations.mjs",
          "includes": [
            "privileged_phishing_resistant_access",
            "production release requires signed live evidence"
          ]
        }
      ]
    },
    {
      "id": "STD_CTRL_004",
      "name": "OAuth security BCP baseline",
      "status": "implemented",
      "profiles": ["NVBES_BASELINE", "NVBES_CRITICAL"],
      "frameworks": ["OAUTH-OIDC-FAPI"],
      "evidence": [
        {
          "path": "apps/identity-service/src/identity.tokens.config.rs",
          "includes": [
            "TokenConfig",
            "allowed_audiences",
            "Identity token issuer must be an HTTPS origin"
          ]
        },
        {
          "path": "apps/identity-service/src/identity.tokens.rs",
          "includes": ["AccessTokenClaims", "JsonWebKeySet", "ACCESS_TOKEN_TTL_SECONDS"]
        }
      ]
    },
    {
      "id": "STD_CTRL_005",
      "name": "FAPI 2.0 high-assurance client profile",
      "status": "partial",
      "profiles": ["NVBES_CRITICAL"],
      "frameworks": ["OAUTH-OIDC-FAPI"],
      "gap": "Configuration policy exists; complete asymmetric JAR validation, sender-constrained token verification and conformance-suite evidence remain release gates.",
      "target": "Before enabling high_assurance clients in production",
      "evidence": [
        {
          "path": "libs/rust/core/src/config.validation.oauth.rs",
          "includes": [
            "validate_fapi_high_assurance",
            "NVBES_FAPI_HIGH_ASSURANCE_ENABLED",
            "NVBES_DPOP_ENABLED or NVBES_MTLS_ENABLED"
          ]
