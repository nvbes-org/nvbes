        {
          "path": "tools/security/check-fapi-conformance-evidence.mjs",
          "includes": ["fapi2-security-profile-final"]
        }
      ]
    },
    {
      "id": "STD_CTRL_006",
      "name": "Govern, identify, protect, detect, respond and recover lifecycle",
      "status": "implemented",
