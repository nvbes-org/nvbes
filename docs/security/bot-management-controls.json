{
  "schemaVersion": 1,
  "source": "https://cheatsheetseries.owasp.org/cheatsheets/Bot_Management_and_Anti-Automation_Cheat_Sheet.html",
  "reviewCadence": "At every auth, signup, public API, rate-limit, risk-signal, or anti-automation control change.",
  "requirements": [
    {
      "id": "BOT_REQ_001",
      "name": "Threat-model sensitive automated abuse flows",
      "owasp": "Threat Modeling Before Controls, Defending Specific Flows",
      "controls": [
        {
          "id": "BOT_CTRL_001",
          "name": "Login and signup anti-automation gates",
          "description": "Protect account creation and login flows with password strength validation, normalized identifiers, and audit logging.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.auth.rs",
              "includes": ["normalize_email", "validate_password", "authenticate"]
            },
            {
              "path": "apps/identity-service/src/identity.http.rs",
              "includes": ["RegisterRequest", "LoginRequest"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_002",
      "name": "Layered defense architecture",
      "owasp": "Layered Defense Architecture",
      "controls": [
        {
          "id": "BOT_CTRL_002",
          "name": "App, risk, and API-layer bot controls",
          "description": "Combine risk signal scoring, PostgreSQL rate limiting, and password hashing defense.",
          "evidence": [
            {
              "path": "libs/rust/trust-risk/src/trust_risk.assessment.rs",
              "includes": ["Assessment", "instantaneous_signals", "RiskSignal"]
            },
            {
              "path": "libs/rust/core/src/limiter.rs",
              "includes": ["RateLimiter", "RateLimitRule", "check_rate_limit"]
            },
            {
              "path": "apps/identity-service/src/identity.auth.rs",
              "includes": ["authenticate", "hash_password"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_003",
      "name": "Rate limiting and quotas",
      "owasp": "Rate Limiting and Quotas",
      "controls": [
        {
          "id": "BOT_CTRL_003",
          "name": "Independent multi-key rate limits",
          "description": "Apply independent per-IP, scoped-key, minute, and pair-based buckets.",
          "evidence": [
            {
              "path": "libs/rust/core/src/limiter.rs",
              "includes": [
                "pub async fn check_dual_rate_limit",
                "format!(\"ip:{ip_key}\")",
                "format!(\"key:{scoped_key}\")",
                "pub async fn check_rate_limit_pair"
              ]
            },
            {
              "path": "apps/billing-service/src/billing.webhooks.rs",
              "includes": ["stripe-signature", "stripe_webhook_handler"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_004",
      "name": "Privacy-aware device and behavior signals",
      "owasp": "Device and Network Fingerprinting (Privacy-Aware)",
      "controls": [
        {
          "id": "BOT_CTRL_004",
          "name": "Scored risk signals and trusted client IP resolution",
          "description": "Score automation signals through validated risk attributes and trusted client IP resolution.",
          "evidence": [
            {
              "path": "libs/rust/trust-risk/src/trust_risk.signal.rs",
              "includes": ["RiskSignal", "validated_name"]
            },
            {
              "path": "libs/rust/core/src/http.client_ip.rs",
              "includes": ["client_ip"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_005",
      "name": "Step-up authentication and challenge verification",
      "owasp": "CAPTCHA and Its Modern Alternatives",
      "controls": [
        {
          "id": "BOT_CTRL_005",
          "name": "Stateful step-up MFA and challenge proof",
          "description": "Issue and verify TOTP codes and challenge step-up proofs for sensitive workflows.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.mfa.rs",
              "includes": ["enroll_totp", "confirm_enrollment", "grant_step_up"]
            },
            {
              "path": "libs/rust/core/src/auth.rs",
              "includes": ["step_up_required_error"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_006",
      "name": "Honeypots, timing traps, and failure deterrence",
      "owasp": "Honeypots and Tarpits",
      "controls": [
        {
          "id": "BOT_CTRL_006",
          "name": "Constant-time dummy hashing and generic errors",
          "description": "Mitigate enumeration attacks through constant-time dummy hashing on unknown identities.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.auth.rs",
              "includes": ["dummy_verify_password", "authentication failed"]
            },
            {
              "path": "libs/rust/core/src/auth.helpers.password.rs",
              "includes": ["dummy_verify_password", "DUMMY_ARGON2ID_HASH"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_007",
      "name": "Public API anti-automation",
      "owasp": "Public APIs",
      "controls": [
        {
          "id": "BOT_CTRL_007",
          "name": "Signed API tokens, quotas, and idempotency",
          "description": "Protect APIs with verified tokens and idempotent request signing.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.tokens.rs",
              "includes": ["AccessTokenClaims", "TokenService", "pub fn verify("]
            },
            {
              "path": "libs/rust/core/src/idempotency.rs",
              "includes": ["request_signature_includes_method_path_and_body_hash", "validate_key"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_008",
      "name": "Graduated response strategy",
      "owasp": "Response Strategy: Don't Always Block",
      "controls": [
        {
          "id": "BOT_CTRL_008",
          "name": "Rule-based recommendations and rate-limit headers",
          "description": "Use domain rules for recommendation actions (Deny, StepUp, Review) and standard rate limit headers.",
          "evidence": [
            {
              "path": "libs/rust/trust-risk/src/trust_risk.rules.rs",
              "includes": ["RuleSet", "Recommendation", "RiskBand"]
            },
            {
              "path": "libs/rust/core/src/limiter.rs",
              "includes": ["ratelimit-limit", "ratelimit-remaining", "ratelimit-reset"]
            },
            {
              "path": "libs/rust/core/src/http.error.rs",
              "includes": ["too_many_requests", "rate_limit_info"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_009",
      "name": "Logging and monitoring",
      "owasp": "Logging and Monitoring",
      "controls": [
        {
          "id": "BOT_CTRL_009",
          "name": "Risk and security telemetry",
          "description": "Record security and risk assessment events in append-only audit tables.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.auth.rs",
              "includes": ["audit(&mut tx, principal_id, \"identity.authenticated\")"]
            },
            {
              "path": "apps/trust-risk-service/src/trust_risk.audit.rs",
              "includes": ["trust_risk_audit_events", "AuditEvent"]
            }
          ]
        }
      ]
    },
    {
      "id": "BOT_REQ_010",
      "name": "Credential stuffing defenses",
      "owasp": "Login (OAT-008), Common Threats and Risks",
      "controls": [
        {
          "id": "BOT_CTRL_010",
          "name": "Dual-bucket rate limiting and robust password checks",
          "description": "Throttling prevents automated credential attacks while password checks enforce complexity.",
          "evidence": [
            {
              "path": "libs/rust/core/src/limiter.rs",
              "includes": ["RateLimiter", "check_rate_limit_pair", "rate_limited"]
            },
            {
              "path": "libs/rust/core/src/auth.helpers.password.rs",
              "includes": ["hash_password", "verify_password", "argon2"]
            },
            {
              "path": "libs/rust/core/src/auth.helpers.validation.rs",
              "includes": ["validate_password", "MIN_PASSWORD_LENGTH", "MAX_PASSWORD_LENGTH"]
            }
          ]
        }
      ]
    }
  ]
}
