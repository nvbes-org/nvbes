{
  "schemaVersion": 1,
  "source": "https://cheatsheetseries.owasp.org/cheatsheets/Authorization_Cheat_Sheet.html",
  "reviewCadence": "At access-control design, before authorization-sensitive releases, and after every authorization incident.",
  "requirements": [
    {
      "id": "AUTHZ_REQ_001",
      "name": "Least privilege and deny by default",
      "owasp": "Enforce Least Privileges, Deny by Default",
      "controls": [
        {
          "id": "AUTHZ_CTRL_001",
          "name": "Central workspace policy",
          "description": "Authorize workspace actions through a central policy that grants only explicit role/action/context combinations.",
          "evidence": [
            {
              "path": "libs/rust/core/src/authz.policy.rs",
              "includes": ["pub fn is_allowed", "owner_allows", "admin_allows", "member_allows"]
            },
            {
              "path": "libs/rust/core/src/authz.policy.tests.rs",
              "includes": [
                "admin_cannot_manage_billing_or_delete_workspace",
                "viewer_is_read_only",
                "owner_cannot_invite_or_remove_another_owner"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_002",
      "name": "Server-side authorization on every request",
      "owasp": "Validate the Permissions on Every Request",
      "controls": [
        {
          "id": "AUTHZ_CTRL_002",
          "name": "Route-level authorization gates",
          "description": "Protected HTTP routes authorize the authenticated actor before executing operations.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.authz.rs",
              "includes": ["AuthzDecisionRequest", "AuthzDecisionResponse", "authz_decision"]
            },
            {
              "path": "apps/identity-service/src/identity.authz.tests.rs",
              "includes": ["authz_decision_fails_cleanly_without_configured_token_keys"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_003",
      "name": "Resource-context authorization and IDOR resistance",
      "owasp": "Ensure Lookup IDs are Not Accessible Even When Guessed or Cannot Be Tampered With",
      "controls": [
        {
          "id": "AUTHZ_CTRL_003",
          "name": "Object and resource context",
          "description": "Load authorization context through workspace-scoped object lookups before object-level actions are evaluated.",
          "evidence": [
            {
              "path": "libs/rust/core/src/authz.context.rs",
              "includes": ["pub struct ResourceContext", "owns_resource", "target_role"]
            },
            {
              "path": "libs/rust/core/src/authz.policy.tests.rs",
              "includes": [
                "member_can_only_modify_owned_objects",
                "member_share_link_requires_policy_and_ownership"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_004",
      "name": "Tenant, team, and workspace boundaries",
      "owasp": "Enforce Authorization Checks on Static Resources, Server-Side Access Control",
      "controls": [
        {
          "id": "AUTHZ_CTRL_004",
          "name": "Scoped workspace and team access",
          "description": "Reject access when actor does not possess the requisite workspace or team membership.",
          "evidence": [
            {
              "path": "libs/rust/core/src/authz.policy.tests.rs",
              "includes": [
                "workspace_membership_roles_cover_expected_permission_boundaries",
                "member_can_only_modify_owned_objects"
              ]
            },
            {
              "path": "apps/account-service/src/account.teams.rs",
              "includes": ["struct Team", "router", "join_code"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_005",
      "name": "API token scope authorization",
      "owasp": "Verify the Authorization Checks",
      "controls": [
        {
          "id": "AUTHZ_CTRL_005",
          "name": "Machine and token scope checks",
          "description": "Require action-specific token scopes and reject requests outside their authenticated scope.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.authz.rs",
              "includes": ["introspect", "claims.scope", "Token has no authorized scopes"]
            },
            {
              "path": "apps/identity-service/src/identity.tokens.rs",
              "includes": ["AccessTokenClaims", "token_type", "scope"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_006",
      "name": "Sensitive action step-up authorization",
      "owasp": "Implement Appropriate Access Controls",
      "controls": [
        {
          "id": "AUTHZ_CTRL_006",
          "name": "Reauthentication for high-risk actions",
          "description": "Mark high-risk authorization decisions as requiring step-up authentication.",
          "evidence": [
            {
              "path": "libs/rust/core/src/authz.action.rs",
              "includes": [
                "pub fn action_requires_step_up",
                "WorkspaceAction::ManageBilling",
                "WorkspaceAction::DeleteWorkspace"
              ]
            },
            {
              "path": "libs/rust/core/src/authz.policy.tests.rs",
              "includes": ["sensitive_actions_require_step_up"]
            },
            {
              "path": "apps/identity-service/src/identity.mfa.rs",
              "includes": ["grant_step_up", "STEP_UP_TTL_MINUTES"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_007",
      "name": "Privileged platform operations authorization",
      "owasp": "Enforce Least Privileges",
      "controls": [
        {
          "id": "AUTHZ_CTRL_007",
          "name": "Platform operator permissions and session gates",
          "description": "Require explicit operator roles, permissions, confirmation, and idempotency for privileged internal actions.",
          "evidence": [
            {
              "path": "libs/rust/platform/src/platform.operations.service.rs",
              "includes": [
                "actor.permits(permission)",
                "OperationsError::Forbidden",
                "idempotency_key"
              ]
            },
            {
              "path": "libs/rust/platform/src/platform.cockpit.auth.rs",
              "includes": ["OperatorSession", "DEFAULT_OPERATOR_ROLE", "permits"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_008",
      "name": "Team and member administration authorization",
      "owasp": "Attribute or Feature-Based Access Control",
      "controls": [
        {
          "id": "AUTHZ_CTRL_008",
          "name": "Team administration guards",
          "description": "Permit team actions only to eligible roles inside the correct profile context.",
          "evidence": [
            {
              "path": "apps/account-service/src/account.teams.rs",
              "includes": ["ensure_profile", "CreateTeam", "JoinTeam"]
            },
            {
              "path": "libs/rust/core/src/authz.role.rs",
              "includes": ["WorkspaceRole", "IdentityRole", "Owner", "Admin", "Member", "Viewer"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_009",
      "name": "Database advisory locks and transaction isolation",
      "owasp": "Server-Side Access Control",
      "controls": [
        {
          "id": "AUTHZ_CTRL_009",
          "name": "Transaction-scoped advisory locks for authorization and mutation",
          "description": "Acquire transactional advisory locks to prevent concurrent mutations.",
          "evidence": [
            {
              "path": "libs/rust/platform/src/platform.operations.service.rs",
              "includes": ["pg_advisory_xact_lock", "actor.operator_id"]
            },
            {
              "path": "apps/billing-service/src/billing.webhooks.rs",
              "includes": ["pg_advisory_xact_lock", "event.id"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_010",
      "name": "Denied authorization logging and monitoring",
      "owasp": "Logging and Monitoring",
      "controls": [
        {
          "id": "AUTHZ_CTRL_010",
          "name": "Permission denied and security audit events",
          "description": "Record denied authorization and security events with structured audit entries.",
          "evidence": [
            {
              "path": "apps/identity-service/src/identity.auth.rs",
              "includes": ["identity_audit_events", "identity.authenticated"]
            },
            {
              "path": "apps/trust-risk-service/src/trust_risk.audit.rs",
              "includes": ["trust_risk_audit_events", "AuditEvent"]
            },
            {
              "path": "apps/account-service/src/account.audit.rs",
              "includes": ["account_audit_events", "AuditInput", "record"]
            }
          ]
        }
      ]
    },
    {
      "id": "AUTHZ_REQ_011",
      "name": "Policy decision consistency",
      "owasp": "Prefer Attribute and Relationship Based Access Control over RBAC",
      "controls": [
        {
          "id": "AUTHZ_CTRL_011",
          "name": "Policy evaluation consistency across domains",
          "description": "Expose policy decisions through the same role, action, and resource context model.",
          "evidence": [
            {
              "path": "libs/rust/core/src/authz.decision.rs",
              "includes": [
                "pub struct WorkspaceDecision",
                "pub allowed: bool",
                "pub requires_step_up: bool"
              ]
            },
            {
              "path": "libs/rust/core/src/authz.policy.tests.rs",
              "includes": ["action_requires_step_up", "is_allowed"]
            }
          ]
        }
      ]
    }
  ]
}
