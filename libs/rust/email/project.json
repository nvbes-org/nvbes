{
  "name": "email",
  "projectType": "library",
  "root": "libs/rust/email",
  "sourceRoot": "libs/rust/email/src",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo check --locked --package nvbes-email --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo nextest run --locked --package nvbes-email",
        "cwd": "."
      }
    },
    "test:database": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo nextest run --locked --package nvbes-email",
        "cwd": "."
      }
    },
    "test:contract": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test archive/apps/email-worker/tests/container-contract.test.mjs",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:platform", "type:lib", "domain:email", "layer:domain"]
}
