{
  "name": "@nvbes/identity-sdk-web",
  "version": "0.1.0",
  "description": "nvbes Identity SDK for web browsers (secure cookies)",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../../node_modules/vite-plus/bin/vp pack",
    "check": "pnpm run typecheck",
    "dev": "node ../../../node_modules/vite-plus/bin/vp pack --watch",
    "format:check": "node ../../../node_modules/vite-plus/bin/vp fmt --check src package.json tsconfig.json",
    "lint": "node ../../../node_modules/vite-plus/bin/vp lint src --ignore-pattern 'src/**/*.test.ts' --ignore-pattern 'src/**/*.spec.ts' --ignore-pattern 'src/**/__tests__/**'",
    "test": "node ../../../node_modules/vite-plus/bin/vp test",
    "typecheck": "tsc --pretty false --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nvbes/http-client": "workspace:*",
    "@nvbes/identity-sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "js-cookie": "^3.0.5"
  }
}
