{
  "name": "@nvbes/email-ui",
  "version": "0.1.0",
  "private": true,
  "description": "React Email design system and transactional email templates for nvbes",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test && pnpm run generated:check",
    "format:check": "node ../../../node_modules/vite-plus/bin/vp fmt --check src package.json project.json tsconfig.json",
    "generated:check": "tsx src/email-ui.generate.tsx --check",
    "generate": "tsx src/email-ui.generate.tsx",
    "lint": "node ../../../node_modules/vite-plus/bin/vp lint src",
    "test": "node ../../../node_modules/vite-plus/bin/vp test",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "^6.9.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
