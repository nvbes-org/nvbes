{
  "name": "@nvbes/web-ui",
  "version": "0.1.0",
  "description": "Shared composite web UI for reusable account switching flows",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node ../../../node_modules/vite-plus/bin/vp pack",
    "check": "pnpm run typecheck",
    "dev": "node ../../../node_modules/vite-plus/bin/vp pack --watch",
    "format:check": "node ../../../node_modules/vite-plus/bin/vp fmt --check src package.json tsconfig.json",
    "lint": "node ../../../node_modules/vite-plus/bin/vp lint src",
    "test": "node ../../../node_modules/vite-plus/bin/vp test",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
