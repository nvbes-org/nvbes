{
  "name": "@nvbes/web-ui",
  "version": "0.1.0",
  "description": "Shared composite web UI for reusable account switching flows",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "pnpm run typecheck",
    "dev": "vp pack --watch",
    "format:check": "vp fmt --check src package.json tsconfig.json",
    "lint": "vp lint src",
    "test": "vp test",
    "typecheck": "tsgo -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "catalog:",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
