{
  "name": "@nvbes/email-templates",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.ts"
  },
  "scripts": {
    "build": "tsx scripts/build-templates.ts",
    "check": "pnpm run typecheck",
    "format:check": "node ../../../node_modules/vite-plus/bin/vp fmt --check src scripts package.json",
    "lint": "node ../../../node_modules/vite-plus/bin/vp lint src scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@json-render/react-email": "latest",
    "@react-email/components": "latest",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
