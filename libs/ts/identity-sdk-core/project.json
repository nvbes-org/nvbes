{
  "name": "identity-sdk-core",
  "projectType": "library",
  "root": "libs/ts/identity-sdk-core",
  "sourceRoot": "libs/ts/identity-sdk-core/src",
  "tags": ["scope:oss", "type:lib", "domain:identity", "layer:sdk"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/openapi.json",
        "{projectRoot}/openapi.contract.test.mjs",
        "{projectRoot}/src/types.gen.ts"
      ],
      "options": {
        "command": "pnpm --dir libs/ts/identity-sdk-core check"
      }
    },
    "format:check": {
      "executor": "nx:run-script",
      "options": { "script": "format:check" }
    },
    "generate:ts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir libs/ts/identity-sdk-core generate:ts"
      }
    },
    "generate:rust": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir libs/ts/identity-sdk-core generate:rust"
      }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": { "script": "lint" }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/openapi.json",
        "{projectRoot}/openapi.contract.test.mjs",
        "{projectRoot}/src/types.gen.ts"
      ],
      "options": {
        "command": "pnpm --dir libs/ts/identity-sdk-core test"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "options": { "script": "typecheck" }
    }
  }
}
