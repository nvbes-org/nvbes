{
  "name": "@nvbes/web-runtime",
  "version": "0.1.0",
  "description": "Shared frontend runtime for TanStack Query and Effect workflows",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./posthog": {
      "types": "./dist/posthog.d.mts",
      "import": "./dist/posthog.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@nvbes/http-client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "effect": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
