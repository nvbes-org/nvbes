{
  "name": "@nvbes/identity-sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript pour intégrer nvbes Identity (OAuth2)",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "node ../../../node_modules/vite-plus/bin/vp pack",
    "check": "pnpm run typecheck",
    "dev": "node ../../../node_modules/vite-plus/bin/vp pack --watch",
    "format:check": "node ../../../node_modules/vite-plus/bin/vp fmt --check src package.json tsconfig.json vite.config.ts",
    "lint": "node ../../../node_modules/vite-plus/bin/vp lint src",
    "test": "node ../../../node_modules/vite-plus/bin/vp test run",
    "typecheck": "node ../../../node_modules/vite-plus/bin/vp check src package.json tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "@nvbes/http-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
