{
  "name": "docs",
  "projectType": "application",
  "root": "apps/docs",
  "sourceRoot": "apps/docs/src",
  "tags": ["scope:internal", "type:app", "domain:developer", "layer:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build",
        "cwd": "apps/docs"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "apps/docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "apps/docs"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../tools/doc-system/validate-docs.mjs",
        "cwd": "apps/docs"
      }
    }
  }
}
