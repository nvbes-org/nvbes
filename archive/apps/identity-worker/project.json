{
  "name": "identity-worker",
  "projectType": "application",
  "root": "apps/identity-worker",
  "sourceRoot": "apps/identity-worker/src",
  "tags": ["scope:oss", "type:app", "domain:identity", "layer:app"],
  "namedInputs": {
    "rustSources": [
      "{projectRoot}/Cargo.toml",
      "{projectRoot}/src/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/apps/identity-service/migrations/**/*",
      "{workspaceRoot}/libs/rust/**/Cargo.toml",
      "{workspaceRoot}/libs/rust/**/src/**/*",
      {
        "runtime": "rustc --version --verbose"
      },
      {
        "runtime": "cargo --version"
      }
    ]
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["rustSources"],
      "outputs": [],
      "options": {
        "command": "cargo check --package nvbes-identity-worker --all-targets --locked",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "inputs": [
        "rustSources",
        "{workspaceRoot}/scripts/test-identity-worker.sh",
        "{workspaceRoot}/scripts/lib/test-env.sh",
        "{workspaceRoot}/scripts/lib/workspace-env.sh",
        "{workspaceRoot}/scripts/lib/validate-destructive-test-database.mjs"
      ],
      "outputs": [],
      "options": {
        "command": "bash scripts/test-identity-worker.sh",
        "cwd": "."
      }
    },
    "test-container-contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/Cargo.toml",
        "{projectRoot}/Dockerfile",
        "{projectRoot}/src/main.rs",
        "{projectRoot}/tests/*.mjs",
        "{workspaceRoot}/tools/container-contract/cargo-lock.mjs",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock"
      ],
      "options": {
        "command": "node --test apps/identity-worker/tests/container-contract.test.mjs",
        "cwd": "."
      }
    }
  }
}
