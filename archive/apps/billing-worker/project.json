{
  "name": "billing-worker",
  "projectType": "application",
  "root": "apps/billing-worker",
  "sourceRoot": "apps/billing-worker/src",
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "cargo check --locked --package nvbes-billing-worker --all-targets",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "cargo test --locked --package nvbes-billing-worker",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:cloud", "type:app", "domain:billing", "layer:app"]
}
