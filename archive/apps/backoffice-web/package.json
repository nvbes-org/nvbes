{
  "name": "nvbes-backoffice-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite-plus/bin/vp dev",
    "build": "tsc -b && node ../../node_modules/vite-plus/bin/vp build && node ../../scripts/upload-grafana-sourcemaps.mjs backoffice-web dist && node ../../scripts/remove-public-sourcemaps.mjs dist",
    "check": "pnpm run typecheck",
    "preview": "node ../../node_modules/vite-plus/bin/vp preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "node ../../node_modules/vite-plus/bin/vp lint",
    "format": "node ../../node_modules/vite-plus/bin/vp fmt --write",
    "format:check": "node ../../node_modules/vite-plus/bin/vp fmt --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@nvbes/backoffice-service-sdk-core": "workspace:*",
    "@nvbes/web-runtime": "workspace:*",
    "@nvbes/web-ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "catalog:"
  }
}
