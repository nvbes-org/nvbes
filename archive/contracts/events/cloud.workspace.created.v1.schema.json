        "owner_principal_id",
        "region_id"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "data_residency": {
          "type": "string",
          "minLength": 1
