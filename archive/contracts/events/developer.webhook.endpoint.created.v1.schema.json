        "endpoint_id",
        "event_types"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
