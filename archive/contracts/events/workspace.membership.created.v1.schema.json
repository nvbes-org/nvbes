{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/workspace.membership.created.v1.schema.json",
  "title": "workspace.membership.created v1",
  "type": "object",
  "required": ["event_type", "event_version", "payload"],
  "properties": {
    "event_type": { "const": "workspace.membership.created" },
    "event_version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["workspace_id", "principal_id", "role"],
      "properties": {
        "workspace_id": { "type": "string", "format": "uuid" },
        "principal_id": { "type": "string", "format": "uuid" },
        "role": { "type": "string", "minLength": 1 }
      }
    }
  }
}
