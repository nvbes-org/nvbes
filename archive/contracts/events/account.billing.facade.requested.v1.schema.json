{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.nvbes.local/events/account.billing.facade.requested.v1.schema.json",
  "title": "account.billing.facade.requested v1",
  "type": "object",
  "required": [
    "event_type",
    "event_version",
    "payload"
  ],
  "properties": {
    "event_type": {
      "const": "account.billing.facade.requested"
    },
    "event_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "workspace_id",
        "operation",
        "requested_at"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
