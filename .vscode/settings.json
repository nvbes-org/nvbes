{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/node_modules": true,
    "**/target": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/.next": true,
    "**/.parcel-cache": true,
    "**/.cache": true
  },
  "files.watcherExclude": {
    "**/.nx/**": true,
    "**/pnpm-store/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/dist": true
  },

  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "npm.packageManager": "pnpm",
  "git.enableSmartCommit": false,
  "git.confirmSync": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "debug.javascript.autoAttachFilter": "smart",
  "debug.toolBarLocation": "docked",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "extensions.ignoreRecommendations": true,
  "rust-analyzer.cargo.allTargets": false,
  "rust-analyzer.cargo.autoreload": false,
  "rust-analyzer.cargo.features": [],
  "rust-analyzer.check.command": "check",
  "rust-analyzer.check.allTargets": false,
  "rust-analyzer.files.excludeDirs": [".git", "node_modules", "target"],
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.lru.capacity": 128,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 1024,
  "typescript.tsserver.useSeparateSyntaxServer": false,
  "lldb.showDisassembly": "never",
  "lldb.displayFormat": "auto",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  }
}
