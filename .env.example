NVBES_BILLING_PORTAL_RETURN_URL="http://localhost:5173/billing"

NVBES_WEB_BASE_URL="http://localhost:3001"
NVBES_API_BASE_URL="http://localhost:4000"
NVBES_IDENTITY_API_BASE_URL="http://localhost:4000"
NVBES_DRIVE_API_BASE_URL="http://localhost:4002"
NVBES_IDENTITY_BASE_URL="http://localhost:4000"
