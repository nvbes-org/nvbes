# Canonical local-development environment contract.
#
# Run `pnpm env:sync` after pulling changes. Existing local values are preserved,
# missing variables receive these safe development defaults, and `.env` remains
# ignored with mode 0600. Never put production credentials in this file.

# Application and network
NVBES_APP_NAME="nvbes Drive"
NVBES_ENV="development"
NVBES_API_PORT="4000"
NVBES_API_MAX_CONCURRENT_REQUESTS=50
NVBES_API_MAX_CONNECTIONS_PER_IP=10
NVBES_HTTP_REQUEST_TIMEOUT_SECS=30
NVBES_TRUSTED_PROXY_CIDRS=
NVBES_IDENTITY_GRPC_PORT="4010"
NVBES_IDENTITY_GRPC_ENDPOINT="http://127.0.0.1:4010"
NVBES_BILLING_SERVICE_PORT="4020"
NVBES_BILLING_GRPC_PORT="4021"
NVBES_BILLING_GRPC_ENDPOINT="http://127.0.0.1:4021"

# Databases
NVBES_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes"
NVBES_IDENTITY_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_identity"
NVBES_IDENTITY_TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_identity_test"
NVBES_ACCOUNT_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_account"
NVBES_BILLING_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_billing"
NVBES_DEVELOPER_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_account"
NVBES_DATABASE_MAX_CONNECTIONS="10"

# Authentication
NVBES_AUTH_SESSION_TTL_HOURS="8760"
NVBES_AUTH_SESSION_IDLE_TTL_MINUTES="720"
NVBES_AUTH_REFRESH_TOKEN_TTL_HOURS="8760"
NVBES_AUTH_VERIFICATION_TTL_HOURS="24"
NVBES_AUTH_PASSWORD_RESET_TTL_MINUTES="30"
NVBES_AUTH_STEP_UP_TTL_MINUTES="15"
NVBES_AUTH_POW_ENABLED=true
# Base64-encoded 32-byte key. Production value must come from Secret Manager.
NVBES_AUTH_FACTOR_ENCRYPTION_KEY=""
NVBES_AUTH_FACTOR_ENCRYPTION_KEY_VERSION="1"

# Dedicated account migration role; must differ from the runtime DB role outside development.
NVBES_ACCOUNT_MIGRATION_DATABASE_URL=""

# Billing
# sandbox starts the Stripe listener with Billing; mock is explicitly offline.
NVBES_STRIPE_DEV_MODE="sandbox"
NVBES_STRIPE_ACCOUNT_ID=""
NVBES_STRIPE_CLI_PROJECT="nvbes-dev"
NVBES_APP_URL="http://localhost:3001"
NVBES_STRIPE_SECRET_KEY=""
NVBES_STRIPE_WEBHOOK_SECRET=""
NVBES_STRIPE_API_BASE_URL="https://api.stripe.com"
NVBES_MOLLIE_API_KEY=""
NVBES_MOLLIE_API_BASE_URL="https://api.mollie.com"
NVBES_MOLLIE_ENABLED="false"
NVBES_BILLING_MOLLIE_ROUTING_STATUS="available"
NVBES_BILLING_EXTERNAL_PROVIDER_FALLBACK_ENABLED="false"
NVBES_BILLING_EXTERNAL_PROVIDER_ROUTING_STATUS="available"
NVBES_BILLING_SUCCESS_URL="http://localhost:5173/billing/success"
NVBES_BILLING_CANCEL_URL="http://localhost:5173/billing/cancel"
NVBES_BILLING_PORTAL_RETURN_URL="http://localhost:5173/billing"

# Service and browser URLs
NVBES_WEB_BASE_URL="http://localhost:3000"
NVBES_IDENTITY_WEB_BASE_URL="http://localhost:3000"
NVBES_ACCOUNT_WEB_BASE_URL="http://localhost:3001"
NVBES_ACCOUNT_WEB_OAUTH_REDIRECT_URIS="http://localhost:3001/oauth/callback"
NVBES_ADDITIONAL_CORS_ORIGINS="http://localhost:3001,http://localhost:5173"
NVBES_API_BASE_URL="http://localhost:4000"
NVBES_IDENTITY_SERVICE_BASE_URL="http://localhost:4000"
NVBES_IDENTITY_SERVICE_PORT=4000
NVBES_ACCOUNT_SERVICE_BASE_URL="http://localhost:4001"
NVBES_ACCOUNT_SERVICE_PORT=4001
NVBES_ACCOUNT_PROVISIONING_TOKEN="development-account-provisioning-token"
NVBES_ACCOUNT_AVATAR_STORAGE_MODE=mock
NVBES_ACCOUNT_AVATAR_STORAGE_BUCKET=
NVBES_ACCOUNT_AVATAR_STORAGE_ENDPOINT=
NVBES_ACCOUNT_AVATAR_STORAGE_PUBLIC_ENDPOINT=
NVBES_ACCOUNT_AVATAR_STORAGE_REGION=
NVBES_ACCOUNT_AVATAR_STORAGE_ACCESS_KEY=
NVBES_ACCOUNT_AVATAR_STORAGE_SECRET_KEY=
NVBES_IDENTITY_INTERNAL_TOKEN="development-identity-internal-token"
# Comma-separated principal UUIDs allowed to mint platform_owner operator JWTs.
# Empty deny-all; set the solo operator principal before issuing tokens.
NVBES_IDENTITY_PLATFORM_OPERATOR_PRINCIPALS=
# NVBES_IDENTITY_TOKEN_ISSUER="http://127.0.0.1:3060"
# NVBES_IDENTITY_TOKEN_KEY_ID="identity-dev-1"
# NVBES_IDENTITY_TOKEN_PRIVATE_KEY_PEM=
# NVBES_IDENTITY_TOKEN_PUBLIC_KEY_PEM=
# NVBES_IDENTITY_TOKEN_AUDIENCES="account,billing,platform-operations"
NVBES_BILLING_INTERNAL_TOKEN="development-billing-internal-token"
# Temporary domain operator bearer until Billing adopts the Identity operator JWT.
# NVBES_BILLING_OPERATOR_TOKEN="development-billing-operator-token-32-chars"
NVBES_BILLING_SERVICE_BASE_URL="http://localhost:4020"
NVBES_ACCOUNT_EXPORT_FRAGMENT_MAX_BYTES=4194304
NVBES_BILLING_IDENTITY_CLIENT_ID="billing-service"
NVBES_BILLING_IDENTITY_CLIENT_SECRET="billing-service-secret-key-12345"
NVBES_BACKOFFICE_IDENTITY_CLIENT_ID="backoffice-service"
NVBES_BACKOFFICE_IDENTITY_CLIENT_SECRET="replace-with-a-dedicated-introspection-secret"
VITE_CONSOLE_WEB_BASE_URL="http://localhost:5175"
VITE_CONSOLE_ACCOUNT_CLIENT_ID="console-web"
VITE_ACCOUNT_WEB_BASE_URL="http://localhost:3001"
VITE_LEGAL_BASE_URL="https://nvbes.fr"
VITE_IDENTITY_WEB_BASE_URL="http://localhost:3000"
VITE_IDENTITY_SERVICE_BASE_URL="http://localhost:4000"
VITE_IDENTITY_WEB_PORT=3000
VITE_ACCOUNT_SERVICE_BASE_URL="http://localhost:4001"
VITE_ACCOUNT_OAUTH_CLIENT_ID="account-web"
VITE_ACCOUNT_OAUTH_REDIRECT_URI="http://localhost:3001/oauth/callback"
VITE_DEVELOPER_SERVICE_BASE_URL="http://localhost:4040"
NVBES_DEVELOPER_HTTP_PORT=4040
NVBES_DEVELOPER_GRPC_PORT=4041
NVBES_DEVELOPER_IDENTITY_CLIENT_ID="developer-service"
NVBES_DEVELOPER_IDENTITY_CLIENT_SECRET="developer-service-secret-key-12345"
NVBES_DEVELOPER_ALLOWED_ORIGINS="http://localhost:5175"
VITE_BILLING_SERVICE_BASE_URL="http://localhost:4020"
VITE_REACT_QUERY_DEVTOOLS_ENABLED=false
VITE_TANSTACK_ROUTER_DEVTOOLS_ENABLED=false

# Staging tooling (credentials stay local)
NVBES_STAGING_WEB_BASE_URL="https://app.staging.nvbes.example"
NVBES_STAGING_API_BASE_URL="https://api.staging.nvbes.example"
NVBES_STAGING_ACCOUNT_SERVICE_BASE_URL="https://account-service.staging.nvbes.example"
NVBES_STAGING_DATABASE_URL=""
NVBES_STAGING_BILLING_DATABASE_URL=""

NVBES_BETA_SEED_EMAIL="beta-owner+staging@example.com"
NVBES_BETA_SEED_PASSWORD="CHANGE_THIS_PASSWORD"
NVBES_BETA_SEED_WORKSPACE="Beta Staging Workspace"

# Runtime security and privacy
NVBES_JWT_SECRET=""
NVBES_LOG_PII_MASKING=true

NVBES_MAXMIND_GEOLITE_DATABASE_ENABLED=false
NVBES_MAXMIND_GEOLITE_WEB_ENABLED=false
NVBES_MAXMIND_GEOLITE_EULA_ACCEPTED=false
NVBES_MAXMIND_ACCOUNT_ID=
NVBES_MAXMIND_LICENSE_KEY=
NVBES_MAXMIND_WEB_TIMEOUT_SECS=2
NVBES_MAXMIND_WEB_CACHE_TTL_HOURS=168
NVBES_LOYALSOLDIER_GEOIP_ENABLED=false
NVBES_LOYALSOLDIER_GEOIP_LICENSE_ACCEPTED=false
NVBES_BILLING_FRAUD_ENFORCEMENT_ENABLED=false
NVBES_BILLING_FRAUD_STEP_UP_THRESHOLD=60
NVBES_BILLING_FRAUD_MANUAL_REVIEW_THRESHOLD=75
NVBES_BILLING_FRAUD_BLOCK_THRESHOLD=90
# JSON array. Criteria: provider, plan_code, country, min_amount_minor, max_amount_minor.
# Threshold fields are optional: step_up_threshold, manual_review_threshold, block_threshold.
NVBES_BILLING_FRAUD_POLICY_OVERRIDES_JSON=

# Observability
NVBES_OTLP_ENDPOINT=
NVBES_OTLP_AUTHORIZATION_HEADER=
# Local Alloy defaults when the observability profile is running:
# NVBES_OTLP_ENDPOINT=http://127.0.0.1:14317
SENTRY_DSN=
SENTRY_SOURCEMAP_UPLOAD_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_PROJECT_ACCOUNT_WEB=account-web
SENTRY_PROJECT_CONSOLE_WEB=console-web
SENTRY_PROJECT_BACKOFFICE_WEB=backoffice-web
SENTRY_URL=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
NVBES_POSTHOG_ENABLED=false
NVBES_POSTHOG_HOST=http://localhost:18000
NVBES_POSTHOG_PROJECT_TOKEN=
NVBES_PRODUCT_ANALYTICS_ENABLED=false
NVBES_PRODUCT_ANALYTICS_TOKEN=
NVBES_ANALYTICS_ID_SALT=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=http://localhost:18000
VITE_ANALYTICS_ID_SALT=
POSTHOG_SOURCEMAP_UPLOAD_ENABLED=false
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://eu.posthog.com
VITE_FARO_URL_ACCOUNT_WEB=
VITE_FARO_URL=
VITE_GRAFANA_FARO_URL=
VITE_FARO_API_KEY=
VITE_FARO_RELEASE=
VITE_FARO_ENVIRONMENT=
VITE_FARO_SESSION_SAMPLE_RATE=1
VITE_FARO_TRACING_ORIGINS=http://localhost:4000,http://localhost:3001
NVBES_REQUIRE_FARO_ACCOUNT_WEB=false
GRAFANA_FARO_SOURCEMAP_ENDPOINT=
GRAFANA_FARO_SOURCEMAP_API_KEY=
GRAFANA_FARO_SOURCEMAP_UPLOAD_ENABLED=false
GRAFANA_CLOUD_STACK_ID=
GRAFANA_FARO_APP_ID_ACCOUNT_WEB=
GRAFANA_FARO_APP_ID_CONSOLE_WEB=
GRAFANA_FARO_APP_ID_BACKOFFICE_WEB=
NVBES_RELEASE=
VITE_NVBES_BUILD_ID=
# Local Alloy Faro receiver when the observability profile is running:
# VITE_FARO_URL_ACCOUNT_WEB=http://localhost:12347/collect
NVBES_PROFILING_ENABLED=false
NVBES_PROFILING_ENDPOINT=http://127.0.0.1:4040
NVBES_PROFILING_SAMPLE_RATE_HZ=100
NVBES_PROFILING_BASIC_AUTH_USER=
NVBES_PROFILING_BASIC_AUTH_PASSWORD=
NVBES_OBSERVABILITY_INTERNAL_TOKEN=
NVBES_ACCOUNT_WORKER_METRICS_BIND_ADDR=127.0.0.1:4102
NVBES_BILLING_WORKER_METRICS_BIND_ADDR=127.0.0.1:4104

# TLS and mTLS
NVBES_TLS_ENABLED=false
NVBES_TLS_CERT_PATH=/etc/nvbes/tls/server.crt
NVBES_TLS_KEY_PATH=/etc/nvbes/tls/server.key
NVBES_MTLS_ENABLED=false
NVBES_MTLS_PORT=4443
NVBES_TLS_CLIENT_CA_PATH=
NVBES_MTLS_CLIENT_CERT_PATH=
NVBES_MTLS_CLIENT_KEY_PATH=

# Request payload encryption
NVBES_REQUEST_E2EE_ENABLED=false
NVBES_REQUEST_E2EE_REQUIRED=false
NVBES_REQUEST_E2EE_KEY_ID="kid_dev_01"
NVBES_REQUEST_E2EE_SECRET=""

# Transactional email
NVBES_EMAIL_PROVIDER=smtp
NVBES_SMTP_HOST="127.0.0.1"
NVBES_SMTP_PORT=1025
NVBES_SMTP_USERNAME=
NVBES_SMTP_PASSWORD=
NVBES_SMTP_STARTTLS=false
# For browser/beta flows: NVBES_EMAIL_PROVIDER=test-capture
# NVBES_EMAIL_TEST_CAPTURE_DIR="/absolute/private/path"
NVBES_EMAIL_FROM_EMAIL="no-reply@notify.nvbes.eu"
NVBES_EMAIL_FROM_NAME="nvbes"
NVBES_EMAIL_MESSAGE_ID_DOMAIN="notify.nvbes.eu"
# Configure only after inbound delivery exists:
# NVBES_EMAIL_REPLY_TO="support@nvbes.eu"
NVBES_EMAIL_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_email"
NVBES_EMAIL_GRPC_ENDPOINT="http://127.0.0.1:3040"
NVBES_EMAIL_GRPC_AUTH_TOKEN="development-email-internal-token-32"
NVBES_EMAIL_PRODUCER_TOKENS="identity-service=development-email-internal-token-32,billing-service=development-email-internal-token-32,platform-operations-service=development-email-internal-token-32"
NVBES_EMAIL_HTTP_BIND_ADDR="127.0.0.1:3040"
NVBES_EMAIL_GRPC_BIND_ADDR="127.0.0.1:3040"
NVBES_EMAIL_RUNTIME_ROLE="all"
NVBES_EMAIL_DATA_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
NVBES_EMAIL_RECIPIENT_HMAC_KEY="AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
NVBES_EMAIL_PAYLOAD_RETENTION_DAYS=30
NVBES_EMAIL_LEDGER_RETENTION_DAYS=400
# Production-only email runtime configuration:
# NVBES_SCALEWAY_EMAIL_PROJECT_ID=""
# NVBES_SCALEWAY_EMAIL_SECRET_KEY=""
# NVBES_SCALEWAY_EMAIL_REGION="fr-par"
# NVBES_EMAIL_QUEUE_URL=""
# NVBES_EMAIL_QUEUE_ACCESS_KEY=""
# NVBES_EMAIL_QUEUE_SECRET_KEY=""
# NVBES_EMAIL_QUEUE_REGION="fr-par"
# NVBES_EMAIL_SNS_TOPIC_ARN=""
# NVBES_EMAIL_SNS_CA_BUNDLE_PATH="/run/secrets/scaleway-sns-ca.pem"

# Independent Trust/Risk engine
NVBES_TRUST_RISK_DATABASE_URL="postgres://postgres:postgres@localhost:5432/nvbes_trust_risk"
NVBES_TRUST_RISK_BIND_ADDR="127.0.0.1:3050"
NVBES_TRUST_RISK_GRPC_ENDPOINT="http://127.0.0.1:3050"
NVBES_TRUST_RISK_GRPC_AUTH_TOKEN="development-trust-risk-token-32-value"
NVBES_TRUST_RISK_METRICS_TOKEN="development-trust-risk-token-32-value"
NVBES_TRUST_RISK_PRODUCER_POLICIES='[{"producer":"billing-checkout-fixture","token":"development-trust-risk-token-32-value","signal_prefixes":["network.","payment.","velocity."],"can_assess":true,"can_label":true}]'
NVBES_TRUST_RISK_OPERATOR_TOKENS='[{"actor":"development-operator","token":"development-trust-risk-token-32-value","permissions":["evaluation:read","review:write","rules:write","labels:human"]}]'
NVBES_TRUST_RISK_SIGNALS_RETENTION_DAYS=30
NVBES_TRUST_RISK_EVALUATIONS_RETENTION_DAYS=400
NVBES_TRUST_RISK_LABELS_RETENTION_DAYS=400
NVBES_TRUST_RISK_REVIEWS_RETENTION_DAYS=400
NVBES_TRUST_RISK_AUDIT_RETENTION_DAYS=730

NVBES_OTP_PROVIDER=mock
NVBES_TWILIO_API_BASE_URL="https://verify.twilio.com"
# NVBES_TWILIO_ACCOUNT_SID=""
# NVBES_TWILIO_AUTH_TOKEN=""
# NVBES_TWILIO_VERIFY_SERVICE_SID=""

# Object storage and malware scanning
STORAGE_ENABLED=false
STORAGE_BUCKET="nvbes-drive"
STORAGE_ENDPOINT="http://localhost:8333"
STORAGE_PUBLIC_ENDPOINT="http://localhost:8333"
STORAGE_REGION="eu-west-1"
STORAGE_ACCESS_KEY="nvbes"
STORAGE_SECRET_KEY="nvbes-dev-secret"

SCAN_ENABLED=false
SCAN_ENGINE="mock"
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
SCAN_TIMEOUT_SECS=30
QUARANTINE_RETENTION_DAYS=30
SCAN_FAIL_OPEN=true

# Scaleway-managed secrets
# Required only for security library tests; use an isolated local *_test database.
NVBES_SECURITY_TEST_DATABASE_URL=
# Scaleway Key Manager (required when NVBES_KMS_ENABLED=true)
NVBES_KMS_ENABLED=false
NVBES_KMS_REGION=fr-par
NVBES_KMS_KEY_ID=
# Prefer a workload-injected token. SCW_SECRET_KEY is accepted as a fallback.
NVBES_KMS_AUTH_TOKEN=
NVBES_KMS_API_BASE_URL=https://api.scaleway.com

# Scaleway Secret Manager. The latest version is a JSON object keyed by AppConfig
# secret field names (database_url, auth_password_pepper, etc.).
NVBES_SECRET_MANAGER_ENABLED=false
NVBES_SECRET_MANAGER_REGION=fr-par
NVBES_SECRET_MANAGER_SECRET_ID=
NVBES_SECRET_MANAGER_AUTH_TOKEN=
NVBES_SECRET_MANAGER_API_BASE_URL=https://api.scaleway.com
NVBES_FAPI_HIGH_ASSURANCE_ENABLED=false
# Required in production when high assurance is enabled. SHA-256 of the approved
# OpenID/FAPI conformance evidence manifest.
NVBES_FAPI_CONFORMANCE_EVIDENCE_SHA256=

# Local quality / smoke targets (pnpm test:smoke:contract, test:e2e:critical)
NVBES_TARGET_ENV="local"
NVBES_EMAIL_TEST_CAPTURE_DIR="/tmp/nvbes-email-capture"
NVBES_ALLOW_DESTRUCTIVE_TEST_DATABASE="account-quality-v1"
NVBES_OPENAPI_SPEC_PATH="docs/testing/v1/openapi-smoke.json"
