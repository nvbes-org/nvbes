VITE_IDENTITY_WEB_BASE_URL="http://localhost:3001"
VITE_IDENTITY_API_BASE_URL="http://localhost:4000"
VITE_IDENTITY_CLIENT_ID="drive-web"

NVBES_STAGING_WEB_BASE_URL="https://app.staging.nvbes.example"
NVBES_STAGING_API_BASE_URL="https://api.staging.nvbes.example"
NVBES_STAGING_IDENTITY_API_BASE_URL="https://identity-api.staging.nvbes.example"
NVBES_STAGING_DRIVE_API_BASE_URL="https://drive-api.staging.nvbes.example"
NVBES_STAGING_DATABASE_URL=""

NVBES_BETA_SEED_EMAIL="beta-owner+staging@example.com"
NVBES_BETA_SEED_PASSWORD="CHANGE_THIS_PASSWORD"
NVBES_BETA_SEED_WORKSPACE="Beta Staging Workspace"

NVBES_JWT_SECRET=""
NVBES_LOG_PII_MASKING=true

NVBES_SENTRY_DSN=
NVBES_SENTRY_LOGS_ENABLED=false
NVBES_OTLP_ENDPOINT=
NVBES_OTLP_AUTHORIZATION_HEADER=
NVBES_OBSERVABILITY_INTERNAL_TOKEN=
VITE_SENTRY_DSN=
VITE_SENTRY_INGEST_URL=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_SMOKE_ENABLED=false
SENTRY_AUTH_TOKEN=
SENTRY_ORG=nvbes
SENTRY_PROJECT=
SENTRY_PROJECT_DRIVE_WEB=drive-web
SENTRY_PROJECT_IDENTITY_WEB=identity-web

NVBES_TLS_ENABLED=false
NVBES_TLS_CERT_PATH=/etc/nvbes/tls/server.crt
NVBES_TLS_KEY_PATH=/etc/nvbes/tls/server.key

NVBES_REQUEST_E2EE_ENABLED=false
NVBES_REQUEST_E2EE_REQUIRED=false
NVBES_REQUEST_E2EE_KEY_ID="kid_dev_01"
NVBES_REQUEST_E2EE_SECRET=""

SCW_TEM_ENABLED=false
SCW_TEM_FROM_EMAIL="team@nvbes.fr"
SCW_TEM_FROM_NAME="nvbes"
# SCW_TEM_REPLY_TO="support@nvbes.fr"  # defaults to SCW_TEM_FROM_EMAIL if unset

STORAGE_ENABLED=false
STORAGE_BUCKET="nvbes-drive"
STORAGE_ENDPOINT="https://s3.fr-par.scw.cloud"
STORAGE_REGION="fr-par"

SCAN_ENABLED=false
SCAN_ENGINE="mock"
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
SCAN_TIMEOUT_SECS=30
QUARANTINE_RETENTION_DAYS=30
SCAN_FAIL_OPEN=true

NVBES_REDIS_URL="redis://localhost:6379"
