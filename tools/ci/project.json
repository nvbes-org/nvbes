{
  "name": "ci-contracts",
  "projectType": "library",
  "root": "tools/ci",
  "implicitDependencies": [
    "email-worker",
    "terraform-email-production",
    "terraform-email-legacy-stack"
  ],
  "targets": {
    "test:ci-contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/scripts/validate-*-test-database.mjs",
        "{workspaceRoot}/scripts/lib/ci-test-database-host.mjs",
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/infrastructure/**/*",
        "{workspaceRoot}/tools/security/check-ci-cd-security.mjs",
        "{workspaceRoot}/.github/actions/**/*",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/tools/security/ci-secret-policy.mjs"
      ],
      "options": {
        "command": "node --test tools/ci/database-host.test.mjs tools/ci/runner-fallback.test.mjs tools/ci/authorize-pr-cache.test.mjs tools/ci/cargo-affected.test.mjs tools/ci/contracts-runner.test.mjs tools/ci/continuous-integration-contract.test.mjs tools/ci/deployment-provenance-contract.test.mjs tools/ci/identity-restore-contract.test.mjs tools/ci/nx-cache-manager.test.mjs tools/ci/scaleway-cache-manager.test.mjs tools/ci/verify-ci-provenance.test.mjs tools/ci/scope.test.mjs tools/ci/rollout-report.test.mjs tools/ci/rust-runner.test.mjs",
        "cwd": "."
      }
    },
    "test:contract": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/tools/ci/email-deployment-contract.test.mjs",
        "{workspaceRoot}/infrastructure/environments/email-production/**/*",
        "{workspaceRoot}/infrastructure/stacks/email/production/**/*"
      ],
      "options": {
        "command": "pnpm test:pre-deploy",
        "cwd": "."
      }
    },
    "test:lockfile-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --test tools/ci/lockfile.integration.test.mjs tools/ci/nx-cache.integration.test.mjs",
        "cwd": "."
      }
    }
  },
  "tags": ["scope:internal", "type:workspace", "domain:shared", "layer:tooling"]
}
