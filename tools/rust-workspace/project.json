{
  "name": "rust-workspace",
  "projectType": "library",
  "root": "tools/rust-workspace",
  "sourceRoot": "tools/rust-workspace",
  "tags": ["scope:oss", "type:workspace", "domain:shared", "layer:tooling"],
  "implicitDependencies": [
    "email-worker",
    "trust-risk-service",
    "audit",
    "billing",
    "core",
    "identity-sdk-backend",
    "observability",
    "platform",
    "ports",
    "tenancy",
    "trust-risk"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/apps/**/Cargo.toml",
      "{workspaceRoot}/apps/**/src/**/*",
      "{workspaceRoot}/libs/rust/**/Cargo.toml",
      "{workspaceRoot}/libs/rust/**/src/**/*",
      "{workspaceRoot}/libs/rust/platform/migrations/**/*",
      "{workspaceRoot}/vendor/xmlsec/**/*"
    ],
    "production": ["default"]
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo build --workspace --release --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true,
      "dependsOn": ["^build"]
    },
    "check": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo check --workspace --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo check --workspace --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "cargo test --workspace --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": false
    },
    "mutation": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/docs/testing/rust-mutation-thresholds.json",
        "{workspaceRoot}/tools/rust-workspace/check-mutation.mjs"
      ],
      "outputs": ["{workspaceRoot}/.temp/rust"],
      "options": {
        "command": "bash scripts/test-workspace-mutation.sh"
      },
      "configurations": {},
      "parallelism": false,
      "cache": false
    }
  }
}
