{
  "name": "rust-workspace",
  "projectType": "library",
  "root": "tools/rust-workspace",
  "sourceRoot": "tools/rust-workspace",
  "tags": ["scope:oss", "type:workspace", "domain:shared", "layer:tooling"],
  "implicitDependencies": [
    "email-worker",
    "trust-risk-service",
    "audit",
    "billing",
    "core",
    "observability",
    "platform",
    "trust-risk"
  ],
  "namedInputs": {
    "default": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/apps/**/Cargo.toml",
      "{workspaceRoot}/apps/**/src/**/*",
      "{workspaceRoot}/libs/rust/**/Cargo.toml",
      "{workspaceRoot}/libs/rust/**/src/**/*",
      "{workspaceRoot}/libs/rust/platform/migrations/**/*",
      "{workspaceRoot}/vendor/xmlsec/**/*",
      "{workspaceRoot}/libs/rust/core/src/*.sql"
    ],
    "production": ["default"]
  },
  "targets": {
    "test:harness": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node --test tools/rust-workspace/*.test.mjs" }
    },
    "micro-test": {
      "executor": "nx:run-commands",
      "dependsOn": ["test:harness"],
      "cache": false,
      "parallelism": false,
      "options": { "command": "node tools/rust-workspace/micro-test.mjs" }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --all -- --check"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo build --workspace --release --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true,
      "dependsOn": ["^build"]
    },
    "check": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo check --workspace --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": [],
      "options": {
        "command": "cargo clippy --workspace --all-targets --locked -- -D warnings"
      },
      "configurations": {},
      "parallelism": true,
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "bash scripts/with-security-test-db.sh cargo nextest run --workspace --locked"
      },
      "configurations": {},
      "parallelism": true,
      "cache": false
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "{workspaceRoot}/docs/testing/rust-coverage-thresholds.json",
        "{workspaceRoot}/tools/rust-workspace/check-coverage.mjs"
      ],
      "outputs": ["{workspaceRoot}/.temp/rust"],
      "options": {
        "command": "bash scripts/with-security-test-db.sh bash scripts/test-workspace-coverage.sh"
      },
      "configurations": {},
      "parallelism": false,
      "cache": false
    },
    "coverage:gap": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/rust-workspace/coverage-gap.mjs .temp/rust/coverage-workspace.json 90"
      }
    },
    "condition": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/docs/testing/rust-condition-thresholds.json",
        "{workspaceRoot}/tools/rust-workspace/check-coverage.mjs",
        "{workspaceRoot}/tools/rust-workspace/check-condition.mjs"
      ],
      "outputs": ["{workspaceRoot}/.temp/rust"],
      "options": {
        "command": "bash scripts/with-security-test-db.sh bash scripts/test-workspace-condition.sh"
      },
      "configurations": {},
      "parallelism": false,
      "cache": false
    },
    "mutation": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "options": { "command": "node tools/rust-workspace/mutation-v1.mjs" }
    },
    "mutation:baseline": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/docs/testing/rust-mutation-thresholds.json",
        "{workspaceRoot}/tools/rust-workspace/check-mutation.mjs"
      ],
      "outputs": ["{workspaceRoot}/.temp/rust"],
      "options": {
        "command": "bash scripts/test-workspace-mutation.sh"
      },
      "configurations": {},
      "parallelism": false,
      "cache": false
    },
    "test:security-storage": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default"],
      "options": {
        "command": "cargo nextest run --locked -p nvbes-core --lib"
      }
    }
  }
}
